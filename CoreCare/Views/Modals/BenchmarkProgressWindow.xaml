<Window x:Class="CoreCare.Views.Modals.BenchmarkProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ejecutando Benchmark" Height="450" Width="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Border Background="#1c2030" CornerRadius="15" BorderBrush="#3300FFFF" BorderThickness="2">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TxtBenchmarkName" Grid.Row="0" Text="BENCHMARK" 
                       Foreground="Cyan" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>

            <StackPanel x:Name="BasicView" Grid.Row="1" VerticalAlignment="Center" Visibility="Visible">
                <TextBlock x:Name="TxtPercent" Text="0%" Foreground="White" FontSize="48" 
                           FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <ProgressBar x:Name="ProgressBar" Height="15" Foreground="Cyan" Background="#0a0e1a" 
                             BorderThickness="0" Value="0" Maximum="100"/>

                <TextBlock Text="Ejecutando pruebas de rendimiento..." Foreground="Gray" 
                           HorizontalAlignment="Center" Margin="0,15,0,0"/>
            </StackPanel>

            <Grid x:Name="PremiumView" Grid.Row="1" Visibility="Collapsed" Margin="0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#0a0e1a" Margin="5" CornerRadius="8" BorderBrush="Orange" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CPU" Foreground="Gray" HorizontalAlignment="Center" FontSize="10"/>
                        <TextBlock x:Name="TxtCpu" Text="0%" Foreground="Orange" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#0a0e1a" Margin="5" CornerRadius="8" BorderBrush="Cyan" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="RAM" Foreground="Gray" HorizontalAlignment="Center" FontSize="10"/>
                        <TextBlock x:Name="TxtRam" Text="0%" Foreground="Cyan" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#0a0e1a" Margin="5" CornerRadius="8" BorderBrush="Red" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TEMP" Foreground="Gray" HorizontalAlignment="Center" FontSize="10"/>
                        <TextBlock x:Name="TxtTemp" Text="50°C" Foreground="Red" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <TextBlock x:Name="TxtStatus" Text="ESTADO: EN PROCESO" Foreground="#3300FFFF" FontSize="10" FontWeight="Bold"/>
                <Button Content="CANCELAR" HorizontalAlignment="Right" Background="Transparent" 
                        Foreground="Gray" BorderThickness="0" Click="BtnCancel_Click" Cursor="Hand"/>
            </Grid>
        </Grid>
    </Border>
</Window>