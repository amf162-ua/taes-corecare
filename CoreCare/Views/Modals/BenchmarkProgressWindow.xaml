<Window x:Class="CoreCare.Views.Modals.BenchmarkProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ejecutando Benchmark" Height="500" Width="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Border Background="#1c2030" CornerRadius="15" BorderBrush="#3300FFFF" BorderThickness="2">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Título -->
                <RowDefinition Height="Auto"/>
                <!-- Progreso -->
                <RowDefinition Height="*"/>
                <!-- Métricas -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <TextBlock x:Name="TxtBenchmarkName" Grid.Row="0" Text="TEST DE RENDIMIENTO" 
                       Foreground="Cyan" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,30">
                <TextBlock x:Name="TxtPercent" Text="0%" Foreground="White" FontSize="48" 
                           FontWeight="Black" HorizontalAlignment="Center"/>
                <ProgressBar x:Name="ProgressBar" Height="10" Foreground="Cyan" Background="#0a0e1a" 
                             BorderThickness="0" Value="0" Maximum="100" Margin="0,10"/>
                <TextBlock Text="Analizando hardware..." Foreground="Gray" HorizontalAlignment="Center" FontSize="11"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- El Padding se aplica al Border, que sí lo admite -->
                <Border Grid.Column="0" Background="#0a0e1a" CornerRadius="8" BorderBrush="Orange" BorderThickness="1" Padding="15">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CPU" Foreground="Gray" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtCpu" Text="0%" Foreground="Orange" FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#0a0e1a" CornerRadius="8" BorderBrush="Cyan" BorderThickness="1" Padding="15">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="RAM" Foreground="Gray" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtRam" Text="0%" Foreground="Cyan" FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="#0a0e1a" CornerRadius="8" BorderBrush="Red" BorderThickness="1" Padding="15">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TEMP" Foreground="Gray" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtTemp" Text="0°C" Foreground="Red" FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="0,20,0,0">
                <TextBlock x:Name="TxtStatus" Text="PROCESANDO DATOS..." Foreground="#6600FFFF" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="ABORTAR" HorizontalAlignment="Right" Background="Transparent" 
                        Foreground="Gray" BorderThickness="1" BorderBrush="#33FFFFFF" Padding="15,5"
                        Click="BtnCancel_Click" Cursor="Hand"/>
            </Grid>
        </Grid>
    </Border>
</Window>