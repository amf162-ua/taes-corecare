<Window x:Class="CoreCare.Views.Modals.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acceso" Height="550" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="LightActionButton" TargetType="Button">
            <Setter Property="Background" Value="#F4F6F8"/>
            <Setter Property="Foreground" Value="#1B1F24"/>
            <Setter Property="BorderBrush" Value="#C9D1D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E8EDF2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LightLoginTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="#1B1F24"/>
            <Setter Property="Background" Value="#F4F6F8"/>
            <Setter Property="BorderBrush" Value="#C9D1D8"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8EE"/>
                                <Setter Property="Foreground" Value="#1B1F24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F8FAFC" CornerRadius="12" BorderBrush="#D4D1CA" BorderThickness="2">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="AXIOM WORKS" Foreground="#00FFFF" FontSize="26" FontWeight="Black" HorizontalAlignment="Center"/>
                <Separator Background="#3300FFFF" Margin="0,10,0,0"/>
            </StackPanel>

            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                <!-- PESTAÑA DE ACCESO (LOGIN) -->
                <TabItem Header="ACCESO" Style="{StaticResource LightLoginTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Text="USUARIO / EMAIL" Foreground="#4B5563" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox x:Name="UsernameBox" Background="#FFFFFF" Foreground="#1B1F24" BorderBrush="#C9D1D8" Padding="10" Margin="0,0,0,15"/>

                            <TextBlock Text="CONTRASEÑA" Foreground="#4B5563" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="PasswordBox" Background="#FFFFFF" Foreground="#1B1F24" BorderBrush="#C9D1D8" Padding="10" Margin="0,0,0,25"/>

                            <TextBlock x:Name="ErrorText" Foreground="#FF5555" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" HorizontalAlignment="Center"/>

                            <Button Content="INICIAR SESIÓN" Style="{StaticResource LightActionButton}" Height="45" Click="BtnLogin_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- PESTAÑA DE REGISTRO -->
                <TabItem Header="REGISTRO" Style="{StaticResource LightLoginTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Text="NOMBRE COMPLETO" Foreground="#4B5563" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox x:Name="RegNombreBox" Background="#FFFFFF" Foreground="#1B1F24" BorderBrush="#C9D1D8" Padding="10" Margin="0,0,0,15"/>

                            <TextBlock Text="EMAIL (USUARIO)" Foreground="#4B5563" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox x:Name="RegEmailBox" Background="#FFFFFF" Foreground="#1B1F24" BorderBrush="#C9D1D8" Padding="10" Margin="0,0,0,15"/>

                            <TextBlock Text="CONTRASEÑA" Foreground="#4B5563" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="RegPasswordBox" Background="#FFFFFF" Foreground="#1B1F24" BorderBrush="#C9D1D8" Padding="10" Margin="0,0,0,15"/>

                            <TextBlock Text="CONFIRMAR CONTRASEÑA" Foreground="#4B5563" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="RegConfirmPasswordBox" Background="#FFFFFF" Foreground="#1B1F24" BorderBrush="#C9D1D8" Padding="10" Margin="0,0,0,25"/>

                            <TextBlock x:Name="RegErrorText" Foreground="#FF5555" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" HorizontalAlignment="Center"/>

                            <Button Content="CREAR CUENTA" Style="{StaticResource LightActionButton}" Height="45" Margin="0,15,0,0" Click="BtnRegister_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Button Grid.Row="2" Content="CANCELAR" Click="BtnClose_Click" 
                    Background="#F4F6F8" Foreground="#1B1F24" BorderBrush="#C9D1D8" BorderThickness="1" 
                    FontSize="12" Margin="0,15,0,0" Cursor="Hand" Padding="12,6"/>
        </Grid>
    </Border>
</Window>