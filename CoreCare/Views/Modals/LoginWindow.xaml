<Window x:Class="CoreCare.Views.Modals.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acceso" Height="550" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="#00FFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                BorderBrush="#00FFFF" 
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#80FFFF"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#151929" CornerRadius="12" BorderBrush="#00FFFF" BorderThickness="2">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="AXIOM WORKS" Foreground="#00FFFF" FontSize="26" FontWeight="Black" HorizontalAlignment="Center"/>
                <Separator Background="#3300FFFF" Margin="0,10,0,0"/>
            </StackPanel>

            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                <!-- PESTAÑA DE ACCESO (LOGIN) -->
                <TabItem Header="ACCESO" Height="29" Margin="-2,-2,-2,0" VerticalAlignment="Top">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Text="USUARIO / EMAIL" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox x:Name="UsernameBox" Background="#0D1117" Foreground="White" BorderBrush="#3300FFFF" Padding="10" Margin="0,0,0,15"/>

                            <TextBlock Text="CONTRASEÑA" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="PasswordBox" Background="#0D1117" Foreground="White" BorderBrush="#3300FFFF" Padding="10" Margin="0,0,0,25"/>

                            <TextBlock x:Name="ErrorText" Foreground="#FF5555" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" HorizontalAlignment="Center"/>

                            <Button Content="INICIAR SESIÓN" Style="{StaticResource CyberButton}" Height="45" Click="BtnLogin_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- PESTAÑA DE REGISTRO -->
                <TabItem Header="REGISTRO">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Text="NOMBRE COMPLETO" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox x:Name="RegNombreBox" Background="#0D1117" Foreground="White" BorderBrush="#3300FFFF" Padding="10" Margin="0,0,0,15"/>

                            <TextBlock Text="EMAIL (USUARIO)" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox x:Name="RegEmailBox" Background="#0D1117" Foreground="White" BorderBrush="#3300FFFF" Padding="10" Margin="0,0,0,15"/>

                            <TextBlock Text="CONTRASEÑA" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="RegPasswordBox" Background="#0D1117" Foreground="White" BorderBrush="#3300FFFF" Padding="10" Margin="0,0,0,15"/>

                            <TextBlock Text="CONFIRMAR CONTRASEÑA" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="RegConfirmPasswordBox" Background="#0D1117" Foreground="White" BorderBrush="#3300FFFF" Padding="10" Margin="0,0,0,25"/>

                            <TextBlock x:Name="RegErrorText" Foreground="#FF5555" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" HorizontalAlignment="Center"/>

                            <Button Content="CREAR CUENTA" Style="{StaticResource CyberButton}" Height="45" Margin="0,15,0,0" Click="BtnRegister_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Button Grid.Row="2" Content="CONTINUAR COMO INVITADO" Click="BtnGuest_Click" 
                    Background="Transparent" Foreground="#6B7280" BorderThickness="0" 
                    FontSize="12" Margin="0,15,0,0" Cursor="Hand"/>
        </Grid>
    </Border>
</Window>