<Window x:Class="CoreCare.Views.Modals.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acceso" Height="500" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="#00FFFF"/> <Setter Property="Foreground" Value="#000000"/> <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                BorderBrush="#00FFFF" 
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#80FFFF"/> <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#151929" CornerRadius="12" BorderBrush="#00FFFF" BorderThickness="2">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="*"/>    
                <RowDefinition Height="Auto"/> 
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="AXIOM WORKS" Foreground="#00FFFF" FontSize="26" FontWeight="Black" HorizontalAlignment="Center"/>
                <Separator Background="#3300FFFF" Margin="0,10,0,0"/>
            </StackPanel>

            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                <TabItem Header="ACCESO">
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="USUARIO / EMAIL" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtLoginEmail" Background="#0D1117" Foreground="White" BorderBrush="#3300FFFF" Padding="10" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="CONTRASEÑA" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="TxtLoginPassword" Background="#0D1117" Foreground="White" BorderBrush="#3300FFFF" Padding="10" Margin="0,0,0,25"/>

                        <Button Content="INICIAR SESIÓN" Style="{StaticResource CyberButton}" Height="45" Click="BtnLogin_Click"/>
                    </StackPanel>
                </TabItem>
                
                <TabItem Header="REGISTRO" Margin="184,2,-188,-6" RenderTransformOrigin="-0.289,2.107">
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="NOMBRE COMPLETO" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Background="#0D1117" Foreground="White" BorderBrush="#3300FFFF" Padding="10" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="EMAIL" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Background="#0D1117" Foreground="White" BorderBrush="#3300FFFF" Padding="10" Margin="0,0,0,10"/>

                        <Button Content="CREAR CUENTA" Style="{StaticResource CyberButton}" Height="45" Margin="0,15,0,0"/>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <Button Grid.Row="2" Content="CANCELAR" Click="BtnClose_Click" 
                    Background="Transparent" Foreground="#6B7280" BorderThickness="0" 
                    FontSize="12" Margin="0,15,0,0" Cursor="Hand"/>
        </Grid>
    </Border>
</Window>