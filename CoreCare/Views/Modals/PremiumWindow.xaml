<Window x:Class="CoreCare.Views.Modals.PremiumWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Core Care Premium" Height="620" Width="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Border Background="#1c2030" CornerRadius="15" BorderBrush="Orange" BorderThickness="2">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button Content="X" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="Transparent" Foreground="Gray" BorderThickness="0" 
                    FontSize="16" FontWeight="Bold" Cursor="Hand" Click="BtnClose_Click"/>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,5,0,25">
                <Border Width="80" Height="80" CornerRadius="40" Background="#33FFA500" 
                        BorderBrush="Orange" BorderThickness="2" Margin="0,0,0,15"
                        HorizontalAlignment="Center">
                    <TextBlock Text="👑" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="CORE CARE PREMIUM" Foreground="Orange" FontSize="26" FontWeight="Black" HorizontalAlignment="Center"/>
                <TextBlock Text="Desbloquea todo el potencial de tu sistema" Foreground="Gray" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="#11FFA500" BorderBrush="Orange" BorderThickness="1" 
                    CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="$9.99" Foreground="White" FontSize="42" FontWeight="Black" HorizontalAlignment="Center"/>
                    <TextBlock Text="POR MES" Foreground="Orange" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                <ItemsControl x:Name="FeaturesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="22" Height="22" CornerRadius="11" Background="#3300FF00" BorderBrush="LightGreen" BorderThickness="1" Margin="0,0,12,0">
                                    <TextBlock Text="✓" Foreground="LightGreen" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding}" Foreground="#E5E7EB" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="3">
                <Button x:Name="BtnUpgrade" Content="👑 ACTUALIZAR A PREMIUM" Click="BtnUpgrade_Click"
                        Background="Orange" Foreground="Black" FontWeight="Black" FontSize="14" 
                        Padding="15" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <TextBlock Text="Cancela en cualquier momento. Sin compromisos." 
                           Foreground="Gray" FontSize="11" HorizontalAlignment="Center" Margin="0,15,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>