<Window x:Class="CoreCare.Views.Modals.UserProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Perfil de Usuario" Height="750" Width="650"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Border Background="#1c2030" CornerRadius="12" BorderBrush="#3300FFFF" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <Border Width="60" Height="60" CornerRadius="30" Background="#111" BorderBrush="Cyan" BorderThickness="2" Margin="0,0,0,10" HorizontalAlignment="Center">
                        <TextBlock Text="👤" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="PERFIL DE USUARIO" Foreground="Cyan" FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/>
                    <TextBlock Text="Información personal y configuración de hardware" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

                <Button Content="X" Grid.Column="2" VerticalAlignment="Top" Click="BtnClose_Click"
                        Background="Transparent" Foreground="Gray" BorderThickness="0" FontSize="16" FontWeight="Bold" Cursor="Hand"/>
            </Grid>

            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                <TabItem Header="MI PERFIL" Foreground="Cyan" Background="#0a0e1a">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,15,0,0">
                        <StackPanel>
                            <Border Background="#0D1117" BorderBrush="#3300FFFF" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                <StackPanel>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="👤" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="10,0">
                                            <TextBlock Text="NOMBRE DE USUARIO" Foreground="Gray" FontSize="10"/>
                                            <TextBlock x:Name="TxtUserName" Text="Usuario123" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                        </StackPanel>
                                        <Border x:Name="PremiumBadge" Grid.Column="2" Background="#22FFA500" BorderBrush="Orange" BorderThickness="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock Text="👑 PREMIUM" Foreground="Orange" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="EMAIL" Foreground="Gray" FontSize="10"/>
                                            <TextBlock Text="usuario@corecare.com" Foreground="White" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="MIEMBRO DESDE" Foreground="Gray" FontSize="10"/>
                                            <TextBlock Text="25 Marzo 2026" Foreground="White" FontSize="14"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="PremiumPurchaseSection" Background="#1c2030" CornerRadius="12" Padding="20" BorderBrush="Orange" BorderThickness="1" Margin="0,0,0,15">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="ESTADO DE CUENTA" Foreground="Orange" FontWeight="Bold" FontSize="10" Margin="0,0,0,5"/>
                                        <TextBlock Text="PLAN GRATUITO" Foreground="White" FontSize="20" FontWeight="Black"/>
                                        <TextBlock Text="Mejora tu cuenta para desbloquear todas las funciones." Foreground="Gray" FontSize="11" Margin="0,10,0,0"/>
                                    </StackPanel>
                                    <Button Content="CONSEGUIR PREMIUM" Click="BtnUpgrade_Click" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                            Padding="20,10" Background="Orange" Foreground="Black" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#0D1117" BorderBrush="#3300FFFF" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,5,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="47" Foreground="Cyan" FontSize="24" FontWeight="Black" HorizontalAlignment="Center"/>
                                        <TextBlock Text="BENCHMARKS" Foreground="Gray" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#0D1117" BorderBrush="#3300FF00" BorderThickness="1" CornerRadius="8" Padding="10" Margin="5,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="94%" Foreground="LightGreen" FontSize="24" FontWeight="Black" HorizontalAlignment="Center"/>
                                        <TextBlock Text="ÉXITO" Foreground="Gray" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#0D1117" BorderBrush="#33FFA500" BorderThickness="1" CornerRadius="8" Padding="10" Margin="5,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="12.5k" Foreground="Orange" FontSize="24" FontWeight="Black" HorizontalAlignment="Center"/>
                                        <TextBlock Text="SCORE AVG" Foreground="Gray" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="MI HARDWARE" Foreground="Cyan" Background="#0a0e1a">
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Configura los componentes para análisis más precisos" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnCancelEdit" Content="CANCELAR" Visibility="Collapsed" Click="BtnCancel_Click" 
                                        Background="Transparent" Foreground="Gray" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand"/>
                                <Button x:Name="BtnEditSave" Content="EDITAR" Click="BtnEditSave_Click" 
                                        Background="#008B8B" Foreground="White" FontWeight="Bold" Padding="15,5" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="HardwareFormPanel" IsEnabled="False">
                                <TextBlock Text="CPU" Foreground="Cyan" FontSize="11" FontWeight="Bold"/>
                                <TextBox Text="{Binding Cpu}" Background="#0a0e1a" Foreground="White" BorderBrush="#3300FFFF" Padding="10" Margin="0,5,0,10"/>

                                <TextBlock Text="GPU" Foreground="LightGreen" FontSize="11" FontWeight="Bold"/>
                                <TextBox Text="{Binding Gpu}" Background="#0a0e1a" Foreground="White" BorderBrush="#3300FF00" Padding="10" Margin="0,5,0,10"/>

                                <TextBlock Text="RAM" Foreground="MediumPurple" FontSize="11" FontWeight="Bold"/>
                                <TextBox Text="{Binding Ram}" Background="#0a0e1a" Foreground="White" BorderBrush="#33800080" Padding="10" Margin="0,5,0,10"/>

                                <TextBlock Text="ALMACENAMIENTO" Foreground="Orange" FontSize="11" FontWeight="Bold"/>
                                <TextBox Text="{Binding Storage}" Background="#0a0e1a" Foreground="White" BorderBrush="#33FFA500" Padding="10" Margin="0,5,0,10"/>

                                <TextBlock Text="PLACA BASE" Foreground="DodgerBlue" FontSize="11" FontWeight="Bold"/>
                                <TextBox Text="{Binding Motherboard}" Background="#0a0e1a" Foreground="White" BorderBrush="#331E90FF" Padding="10" Margin="0,5,0,10"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>