<Window x:Class="CoreCare.Views.Modals.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pago Seguro" Height="650" Width="450" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Border Background="#1c2030" CornerRadius="12" BorderBrush="#3300FFFF" BorderThickness="2">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnBack" Content="←" Grid.Column="0" Click="BtnBack_Click" 
                        Background="Transparent" Foreground="Cyan" FontSize="20" BorderThickness="0" Cursor="Hand"/>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <Border Width="50" Height="50" CornerRadius="25" Background="#111" BorderBrush="Cyan" BorderThickness="2" Margin="0,0,0,10">
                        <TextBlock Text="🔒" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="PAGO SEGURO" Foreground="Cyan" FontSize="20" FontWeight="Black" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1">
                <TextBlock Text="NÚMERO DE TARJETA" Foreground="Cyan" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtCardNumber" Background="#0a0e1a" Foreground="White" BorderBrush="#3300FFFF" 
                         Padding="10" FontSize="14" Margin="0,0,0,12" TextChanged="TxtCardNumber_TextChanged"/>

                <TextBlock Text="NOMBRE DEL TITULAR" Foreground="Cyan" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtCardName" Background="#0a0e1a" Foreground="White" BorderBrush="#3300FFFF" 
                         Padding="10" FontSize="14" Margin="0,0,0,12" TextChanged="ValidateForm"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="FECHA EXP." Foreground="Cyan" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtExpiry" Background="#0a0e1a" Foreground="White" BorderBrush="#3300FFFF" 
                                 Padding="10" FontSize="14" TextChanged="TxtExpiry_TextChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="CVV" Foreground="Cyan" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtCvv" Background="#0a0e1a" Foreground="White" BorderBrush="#3300FFFF" 
                                 Padding="10" FontSize="14" MaxLength="3" TextChanged="ValidateForm"/>
                    </StackPanel>
                </Grid>

                <Border Background="#112233" BorderBrush="#3300FFFF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                    <StackPanel>
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="Suscripción Premium" Foreground="Gray" FontSize="12" HorizontalAlignment="Left"/>
                            <TextBlock Text="$9.99" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Rectangle Height="1" Fill="#3300FFFF" Margin="0,5"/>
                        <Grid>
                            <TextBlock Text="Total hoy" Foreground="Gray" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="$9.99" Foreground="Cyan" FontWeight="Black" FontSize="18" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                    <TextBlock Text="🔒" Foreground="Cyan" FontSize="12" Margin="0,0,5,0"/>
                    <TextBlock Text="Pago protegido con encriptación bancaria" Foreground="Gray" FontSize="11"/>
                </StackPanel>

                <Button x:Name="BtnPay" Content="CONFIRMAR Y PAGAR" Click="BtnPay_Click" IsEnabled="False"
                        Height="50" Background="#008B8B" Foreground="White" FontWeight="Black" FontSize="14" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Al confirmar el pago, aceptas nuestros términos." 
                       Foreground="Gray" FontSize="10" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </Grid>
    </Border>
</Window>