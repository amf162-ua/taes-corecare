<Window x:Class="CoreCare.Views.Modals.ReportBenchmarkSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Benchmarks del informe"
        Height="430"
        Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Border Background="#1c2030" CornerRadius="14" BorderBrush="#3300FFFF" BorderThickness="2" Padding="26">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Incluir benchmarks en el informe"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Black"/>
                <TextBlock Text="Selecciona las pruebas que quieres ejecutar antes de generar el PDF."
                           Foreground="Gray"
                           FontSize="12"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,18,0,12"
                    Background="#0a0e1a"
                    BorderBrush="#33475566"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">
                <TextBlock Text="Si no quieres ejecutar benchmarks, usa Generar sin benchmarks."
                           Foreground="#B6C2D1"
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="185">
                <ItemsControl ItemsSource="{Binding BenchmarkItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#101827"
                                    BorderBrush="#273449"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,8">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Checked="BenchmarkSelectionChanged"
                                          Unchecked="BenchmarkSelectionChanged"
                                          Cursor="Hand">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding EstimatedTime}"
                                                   Foreground="Gray"
                                                   FontSize="11"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="Cancelar"
                        Grid.Column="0"
                        Click="Cancel_Click"
                        Padding="16,8"
                        Background="Transparent"
                        Foreground="Gray"
                        BorderBrush="#445566"
                        BorderThickness="1"
                        Cursor="Hand"/>

                <Button Content="Generar sin benchmarks"
                        Grid.Column="2"
                        Click="GenerateWithoutBenchmarks_Click"
                        Padding="16,8"
                        Margin="0,0,10,0"
                        Background="#263142"
                        Foreground="White"
                        BorderBrush="#445566"
                        BorderThickness="1"
                        Cursor="Hand"/>

                <Button x:Name="BtnRunSelected"
                        Content="Ejecutar seleccionados"
                        Grid.Column="3"
                        Click="RunSelected_Click"
                        Padding="16,8"
                        Background="#06384a"
                        Foreground="White"
                        BorderBrush="#7CFFFF"
                        BorderThickness="1"
                        FontWeight="Bold"
                        Cursor="Hand"
                        IsEnabled="False"/>
            </Grid>
        </Grid>
    </Border>
</Window>
