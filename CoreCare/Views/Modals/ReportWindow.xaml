<Window x:Class="CoreCare.Views.Modals.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enviar Reporte" Height="700" Width="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Border Background="#1c2030" CornerRadius="12" BorderBrush="#3300FFFF" BorderThickness="1">
        <Grid>
            <Grid x:Name="FormGrid" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#11FF0000" BorderBrush="#33FF0000" BorderThickness="0,0,0,1" Padding="20">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" Background="#22FF0000" BorderBrush="#55FF0000" BorderThickness="1" CornerRadius="8" Margin="0,0,15,0">
                                <TextBlock Text="📄" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ENVIAR REPORTE" Foreground="White" FontSize="20" FontWeight="Black"/>
                                <TextBlock x:Name="TxtBenchmarkName" Text="Benchmark: ---" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Content="X" HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnClose_Click"
                                Background="Transparent" Foreground="Gray" BorderThickness="0" FontSize="16" FontWeight="Bold" Cursor="Hand"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20">
                    <StackPanel>
                        <TextBlock Text="DESCRIBE EL PROBLEMA" Foreground="Cyan" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBox x:Name="TxtDescription" Background="#151a2e" Foreground="White" BorderBrush="#3300FFFF" 
                                 Padding="15" FontSize="14" Height="120" TextWrapping="Wrap" AcceptsReturn="True" 
                                 TextChanged="Form_Changed"/>
                        <TextBlock Text="Mínimo 10 caracteres • Incluye detalles del comportamiento anormal" 
                                   Foreground="Gray" FontSize="10" Margin="0,5,0,25"/>

                        <TextBlock Text="EMPRESA ASOCIADA" Foreground="Cyan" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="CompaniesList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="Company_Click" Background="{Binding BgColor}" BorderBrush="{Binding BorderColor}" 
                                            BorderThickness="2" Margin="5" Padding="15" Cursor="Hand" HorizontalContentAlignment="Left">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                        BorderThickness="2" CornerRadius="8" Padding="10">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Icon}" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" Foreground="{Binding TextColor}" FontWeight="Bold" FontSize="13"/>
                                                            <TextBlock Text="Soporte técnico" Foreground="Gray" FontSize="10"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="#11FFA500" BorderBrush="#33FFA500" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,25,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ️" FontSize="20" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Información del reporte" Foreground="Orange" FontWeight="Bold" FontSize="13"/>
                                    <TextBlock Text="El reporte incluirá automáticamente los datos técnicos y tu descripción. La empresa te contactará para ayudarte." 
                                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" MaxWidth="450" Margin="0,5,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#11000000" BorderBrush="#3300FFFF" BorderThickness="0,1,0,0" Padding="20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Click="BtnClose_Click" Background="Transparent" Foreground="Gray" 
                                BorderBrush="Gray" BorderThickness="1" Padding="15,8" Margin="0,0,10,0" Cursor="Hand"/>

                        <Button x:Name="BtnSubmit" Content="Enviar Reporte" Click="BtnSubmit_Click" IsEnabled="False"
                                Background="#008B8B" Foreground="White" FontWeight="Bold" Padding="20,8" Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="SuccessGrid" Visibility="Collapsed" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="80" Height="80" Background="#2200FF00" BorderBrush="LightGreen" BorderThickness="2" CornerRadius="40" Margin="0,0,0,20" HorizontalAlignment="Center">
                        <TextBlock Text="✓" Foreground="LightGreen" FontSize="40" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="¡REPORTE ENVIADO!" Foreground="White" FontSize="24" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Tu solicitud ha sido enviada exitosamente." Foreground="Gray" FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock Text="La empresa seleccionada te contactará pronto." Foreground="Gray" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>