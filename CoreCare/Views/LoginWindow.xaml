<Window x:Class="CoreCare.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoreCare - Acceso"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Height="520"
        Width="860"
        Background="#F4F1EB">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="#2B2B2B"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="#CFC8BC"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="#CFC8BC"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#01696f"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1.4*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#0E2F33" Padding="36">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="CoreCare" Foreground="White" FontSize="34" FontWeight="Bold" Margin="0,0,0,12"/>
                <TextBlock Text="Acceso para clientes y administradores" Foreground="#D7E7E4" FontSize="16" Margin="0,0,0,18"/>
                
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="White" Margin="28" CornerRadius="18" Padding="26" BorderBrush="#E2DED6" BorderThickness="1">
            <TabControl>
                <TabItem Header="Iniciar sesión">
                    <StackPanel Margin="10,18,10,10">
                        <TextBlock Text="Usuario o correo" FontWeight="SemiBold"/>
                        <TextBox x:Name="LoginIdentifierBox"/>

                        <TextBlock Text="Contraseña" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="LoginPasswordBox"/>

                        <Button Content="Entrar" Click="Login_Click" Margin="0,8,0,10"/>
                        <TextBlock x:Name="LoginStatusText" Foreground="#A13544" TextWrapping="Wrap"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Registrar client">
                    <StackPanel Margin="10,18,10,10">
                        <TextBlock Text="Nombre" FontWeight="SemiBold"/>
                        <TextBox x:Name="RegisterNameBox"/>

                        <TextBlock Text="Usuario" FontWeight="SemiBold"/>
                        <TextBox x:Name="RegisterUsernameBox"/>

                        <TextBlock Text="Correo" FontWeight="SemiBold"/>
                        <TextBox x:Name="RegisterEmailBox"/>

                        <TextBlock Text="Contraseña" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="RegisterPasswordBox"/>

                        <Button Content="Crear cuenta" Click="Register_Click" Margin="0,8,0,10"/>
                        <TextBlock x:Name="RegisterStatusText" Foreground="#A13544" TextWrapping="Wrap"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>