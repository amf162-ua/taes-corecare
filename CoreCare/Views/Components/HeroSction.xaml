<UserControl x:Class="CoreCare.Views.Components.HeroSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:components="clr-namespace:CoreCare.Views.Components"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="CategoryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#2D1C2030"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D1C2030"/>
                    <Setter Property="BorderBrush" Value="#4D06B6D4"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.5"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Main Content -->
        <Grid Grid.Row="1">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#0A0E1A"/>
                <GradientStop Offset="0.5" Color="#1A1F35"/>
                <GradientStop Offset="1" Color="#0A0E1A"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid>
            <Grid.Background>
                <DrawingBrush Viewport="0,0,50,50" ViewportUnits="Absolute" TileMode="Tile">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="Transparent">
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0,50,50"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#0F06B6D4">
                                <GeometryDrawing.Geometry>
                                    <LineGeometry StartPoint="0,0" EndPoint="50,0"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#0F06B6D4">
                                <GeometryDrawing.Geometry>
                                    <LineGeometry StartPoint="0,0" EndPoint="0,50"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Grid.Background>
        </Grid>

        <Ellipse Width="384" Height="384" Fill="#33F97316" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="100,150,0,0">
            <Ellipse.Effect>
                <BlurEffect Radius="120"/>
            </Ellipse.Effect>
        </Ellipse>

        <Ellipse Width="384" Height="384" Fill="#3306B6D4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,100,150">
            <Ellipse.Effect>
                <BlurEffect Radius="120"/>
            </Ellipse.Effect>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" MaxWidth="1024" Margin="0,80,0,80">

                <Border HorizontalAlignment="Center" Margin="0,0,0,32">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#F97316" Opacity="0.5"/>
                    </Border.Effect>
                    <TextBlock Text="⚡" FontSize="100" Foreground="#F97316"/>
                </Border>

                <TextBlock Text="CORE CARE" HorizontalAlignment="Center" FontSize="72" FontWeight="Black" Margin="0,0,0,16">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#F97316"/>
                            <GradientStop Offset="0.5" Color="#06B6D4"/>
                            <GradientStop Offset="1" Color="#3B82F6"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>

                <TextBlock Text="POWERED BY AXIOM WORKS" HorizontalAlignment="Center" FontSize="16" Foreground="#B306B6D4" Margin="0,0,0,24"/>

                <TextBlock HorizontalAlignment="Center" TextAlignment="Center" FontSize="20" Foreground="#D1D5DB" Margin="0,0,0,48" TextWrapping="Wrap">
                    Sistema profesional de benchmarking de última generación.<LineBreak/>
                    Evaluación exhaustiva de rendimiento con precisión absoluta.
                </TextBlock>

                <ItemsControl x:Name="FeaturesList" Margin="0,0,0,60">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0D1117" BorderBrush="#1A00FFFF" BorderThickness="1" CornerRadius="10" Padding="20" Margin="10" Width="180">
                                <StackPanel>
                                    <TextBlock Text="{Binding Icon}" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Desc}" Foreground="Gray" FontSize="11" TextAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl x:Name="CategoriesGrid" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CategoryCardStyle}" Margin="8" BorderBrush="#3306B6D4">
                                <StackPanel>
                                    <Border Width="64" Height="64" CornerRadius="8" Margin="0,0,0,12" Background="#1106B6D4" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" FontSize="32" Foreground="#06B6D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="BtnEnter" Click="BtnEnter_Click" Width="320" Height="65" Cursor="Hand" Background="Transparent" BorderBrush="#06B6D4" BorderThickness="2">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                <Grid>
                                    <Border x:Name="glow" Opacity="0" Background="#06B6D4">
                                        <Border.Effect>
                                            <BlurEffect Radius="15"/>
                                        </Border.Effect>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="[ " Foreground="#06B6D4" FontSize="22" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <TextBlock Text="ACCEDER AL TERMINAL" Foreground="White" FontSize="18" FontWeight="Black" VerticalAlignment="Center" Margin="10,0"/>
                                        <TextBlock Text=" ]" Foreground="#06B6D4" FontSize="22" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="glow" Property="Opacity" Value="0.15"/>
                                    <Setter Property="BorderBrush" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#3306B6D4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </ScrollViewer>
        </Grid>
        <!-- End Main Content -->
        </Grid>
</UserControl>