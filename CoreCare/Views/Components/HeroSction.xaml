<UserControl x:Class="CoreCare.Views.Components.HeroSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Colores para las categorías -->
        <SolidColorBrush x:Key="OrangeColor" Color="#F97316"/>
        <SolidColorBrush x:Key="CyanColor" Color="#06B6D4"/>
        <SolidColorBrush x:Key="PurpleColor" Color="#A855F7"/>
        <SolidColorBrush x:Key="EmeraldColor" Color="#10B981"/>

        <!-- Estilo para tarjetas de categoría -->
        <Style x:Key="CategoryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#2D1C2030"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D1C2030"/>
                    <Setter Property="BorderBrush" Value="#4D06B6D4"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.5"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Fondo gradiente -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#0A0E1A"/>
                <GradientStop Offset="0.5" Color="#1A1F35"/>
                <GradientStop Offset="1" Color="#0A0E1A"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Grid pattern -->
        <Grid>
            <Grid.Background>
                <DrawingBrush Viewport="0,0,50,50" ViewportUnits="Absolute" TileMode="Tile">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="Transparent">
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0,50,50"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#0F06B6D4">
                                <GeometryDrawing.Geometry>
                                    <LineGeometry StartPoint="0,0" EndPoint="50,0"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#0F06B6D4">
                                <GeometryDrawing.Geometry>
                                    <LineGeometry StartPoint="0,0" EndPoint="0,50"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Grid.Background>
        </Grid>

        <!-- Efectos Glow -->
        <Ellipse Width="384" Height="384" Fill="#33F97316" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="100,150,0,0">
            <Ellipse.Effect>
                <BlurEffect Radius="120"/>
            </Ellipse.Effect>
        </Ellipse>

        <Ellipse Width="384" Height="384" Fill="#3306B6D4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,100,150">
            <Ellipse.Effect>
                <BlurEffect Radius="120"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Contenido principal -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" MaxWidth="1024" Margin="0,80,0,80">

                <!-- Logo -->
                <Border HorizontalAlignment="Center" Margin="0,0,0,32">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#F97316" Opacity="0.5"/>
                    </Border.Effect>
                    <!-- Aquí iría tu logo como imagen -->
                    <TextBlock Text="⚡" FontSize="100" Foreground="#F97316"/>
                </Border>

                <!-- Título CORE CARE -->
                <TextBlock Text="CORE CARE" 
                          HorizontalAlignment="Center"
                          FontSize="72" 
                          FontWeight="Black"
                          FontFamily="Orbitron"
                          Margin="0,0,0,16"
                          >
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#F97316"/>
                            <GradientStop Offset="0.5" Color="#06B6D4"/>
                            <GradientStop Offset="1" Color="#3B82F6"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>

                <!-- Subtítulo -->
                <TextBlock Text="POWERED BY AXIOM WORKS"
                          HorizontalAlignment="Center"
                          FontSize="16"
                          FontFamily="Rajdhani"
                          Foreground="#B306B6D4"
                          Margin="0,0,0,24"
                          />

                <!-- Descripción -->
                <TextBlock HorizontalAlignment="Center"
                          TextAlignment="Center"
                          FontSize="20"
                          FontFamily="Rajdhani"
                          Foreground="#D1D5DB"
                          Margin="0,0,0,48"
                          TextWrapping="Wrap">
                    Sistema profesional de benchmarking de última generación.<LineBreak/>
                    Evaluación exhaustiva de rendimiento con precisión absoluta.
                </TextBlock>

                <!-- Grid de categorías -->
                <ItemsControl x:Name="CategoriesGrid" Margin="0,64,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CategoryCardStyle}" 
                                   Margin="8"
                                   BorderBrush="{Binding BorderColor}">
                                <StackPanel>
                                    <Border Width="64" 
                                           Height="64" 
                                           CornerRadius="8"
                                           Margin="0,0,0,12"
                                           HorizontalAlignment="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Offset="0" Color="{Binding ColorStart}"/>
                                                <GradientStop Offset="1" Color="{Binding ColorEnd}"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="{Binding Icon}" 
                                                  FontSize="32" 
                                                  Foreground="{Binding IconColor}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Text="{Binding Label}"
                                              HorizontalAlignment="Center"
                                              FontFamily="Orbitron"
                                              FontWeight="Bold"
                                              FontSize="14"
                                              Foreground="{Binding LabelColor}"
                                              />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>