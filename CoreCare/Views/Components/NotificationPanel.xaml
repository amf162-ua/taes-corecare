<UserControl x:Class="CoreCare.Views.Components.NotificationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="350">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Border Background="#1c2030" CornerRadius="12" BorderBrush="#3300FFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="15" BorderBrush="#1A00FFFF" BorderThickness="0,0,0,1">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="NOTIFICACIONES" Foreground="White" FontWeight="Bold" FontSize="14"/>
                            <Border x:Name="UnreadBadge" Background="Cyan" CornerRadius="10" Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtUnreadCount" Text="0" Foreground="Black" FontSize="10" FontWeight="Black"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Marcar leídas" Click="BtnReadAll_Click"
                                Foreground="Cyan" Background="Transparent" BorderThickness="0" FontSize="10" Cursor="Hand" Margin="0,0,15,0"/>
                        <Button Content="Limpiar todo" Click="BtnClearAll_Click"
                                Foreground="Pink" Background="Transparent" BorderThickness="0" FontSize="10" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" MaxHeight="400" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="NotificationsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="Notification_Click" Background="Transparent" BorderThickness="0" Padding="0" Margin="2">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ItemBorder" Background="#0D1117" Margin="5" Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="#1A00FFFF">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Top" Margin="0,4,12,0" x:Name="TypeDot"/>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" x:Name="TitleTxt" FontWeight="Bold" FontSize="13" Margin="0,0,0,3" Foreground="White"/>
                                                    <TextBlock Text="{Binding Message}" Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                                    <TextBlock Text="{Binding Timestamp}" Foreground="#4B5563" FontSize="9"/>
                                                </StackPanel>

                                                <Ellipse HorizontalAlignment="Right" VerticalAlignment="Top" Width="6" Height="6" Fill="Cyan" 
                                                         Visibility="{Binding ShowUnreadIndicator, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="success">
                                                <Setter TargetName="TypeDot" Property="Fill" Value="LightGreen"/>
                                                <Setter TargetName="TitleTxt" Property="Foreground" Value="LightGreen"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="warning">
                                                <Setter TargetName="TypeDot" Property="Fill" Value="Orange"/>
                                                <Setter TargetName="TitleTxt" Property="Foreground" Value="Orange"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="info">
                                                <Setter TargetName="TypeDot" Property="Fill" Value="Cyan"/>
                                                <Setter TargetName="TitleTxt" Property="Foreground" Value="Cyan"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>