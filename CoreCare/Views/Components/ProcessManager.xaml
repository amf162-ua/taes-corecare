<UserControl x:Class="CoreCare.Views.Components.ProcessManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="MONITOR DE PROCESOS" Foreground="White" FontSize="28" FontWeight="Black" HorizontalAlignment="Center"/>
            <Rectangle Height="2" Width="100" Fill="Cyan" HorizontalAlignment="Center" Margin="0,5,0,10"/>
            <TextBlock Text="Controla los subprocesos que consumen recursos del sistema" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <Grid Margin="0,0,0,25" MaxWidth="900">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1c2030" BorderBrush="Cyan" BorderThickness="1" CornerRadius="8" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Procesos Activos" Foreground="Gray" FontSize="12"/>
                        <TextBlock x:Name="TxtActiveCount" Text="0" Foreground="Cyan" FontSize="26" FontWeight="Black"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#1c2030" BorderBrush="Red" BorderThickness="1" CornerRadius="8" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Procesos Críticos" Foreground="Gray" FontSize="12"/>
                        <TextBlock x:Name="TxtCriticalCount" Text="0" Foreground="Red" FontSize="26" FontWeight="Black"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="#1c2030" BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Procesos Detenidos" Foreground="Gray" FontSize="12"/>
                        <TextBlock x:Name="TxtStoppedCount" Text="0" Foreground="Gray" FontSize="26" FontWeight="Black"/>
                    </StackPanel>
                </Border>
            </Grid>

            <ItemsControl x:Name="ProcessList" MaxWidth="900">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1c2030" BorderBrush="{Binding BorderColor}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="{Binding Name}" Foreground="{Binding BorderColor}" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Pid, StringFormat=' (PID: {0})'}" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
                                            <Border Background="#33FFD700" BorderBrush="Gold" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="10,0,0,0" Visibility="{Binding ProtectedVis}">
                                                <TextBlock Text="PROTEGIDO" Foreground="Gold" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>

                                        <Grid Margin="0,10,0,0" MaxWidth="300" HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="140"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding CpuUsage, StringFormat='CPU: {0}%'}" Foreground="White" FontSize="11" Margin="0,0,0,2"/>
                                                <ProgressBar Value="{Binding CpuUsage}" Maximum="100" Height="6" Background="#0a0e1a" Foreground="{Binding CpuColorBrush}" BorderThickness="0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding RamUsage, StringFormat='RAM: {0} GB'}" Foreground="White" FontSize="11" Margin="0,0,0,2"/>
                                                <ProgressBar Value="{Binding RamProgress}" Maximum="100" Height="6" Background="#0a0e1a" Foreground="Purple" BorderThickness="0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="{Binding ButtonText}" IsEnabled="{Binding IsButtonEnabled}" 
                                            Click="BtnStop_Click" Background="Transparent" Foreground="{Binding BorderColor}" 
                                            BorderBrush="{Binding BorderColor}" BorderThickness="1" Padding="15,8" FontWeight="Bold" Cursor="Hand" VerticalAlignment="Center">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>

                                <Border Background="#11FF0000" BorderBrush="Red" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,15,0,0" Visibility="{Binding CriticalWarningVis}">
                                    <TextBlock Text="⚠️ Consumo excesivo detectado. Afecta al rendimiento del sistema." Foreground="LightCoral" FontSize="11"/>
                                </Border>

                                <Border Background="#11FFFF00" BorderBrush="Yellow" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,15,0,0" Visibility="{Binding FailedWarningVis}">
                                    <TextBlock Text="🛡️ Proceso del sistema protegido. No se puede detener de forma segura." Foreground="Yellow" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>