<UserControl x:Class="CoreCare.Views.Components.ProcessManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="MONITOR DE PROCESOS" Foreground="White" FontSize="28" FontWeight="Black" HorizontalAlignment="Center"/>
            <Rectangle Height="2" Width="100" Fill="Cyan" HorizontalAlignment="Center" Margin="0,5,0,10"/>
            <TextBlock Text="Controla el consumo de memoria de tu sistema en tiempo real" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <!-- Estadísticas: 3 Columnas Restauradas -->
            <Grid Margin="0,0,0,25" MaxWidth="900">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1c2030" BorderBrush="Cyan" BorderThickness="1" CornerRadius="8" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Procesos Activos" Foreground="Gray" FontSize="12"/>
                        <TextBlock x:Name="TxtActiveCount" Text="0" Foreground="Cyan" FontSize="26" FontWeight="Black"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#1c2030" BorderBrush="Red" BorderThickness="1" CornerRadius="8" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Consumo Crítico" Foreground="Gray" FontSize="12"/>
                        <TextBlock x:Name="TxtCriticalCount" Text="0" Foreground="Red" FontSize="26" FontWeight="Black"/>
                    </StackPanel>
                </Border>

                <!-- El contador que querías conservar -->
                <Border Grid.Column="4" Background="#1c2030" BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Procesos Detenidos" Foreground="Gray" FontSize="12"/>
                        <TextBlock x:Name="TxtStoppedCount" Text="0" Foreground="Gray" FontSize="26" FontWeight="Black"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Lista de Procesos sin CPU[cite: 13] -->
            <ItemsControl x:Name="ProcessList" MaxWidth="900">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1c2030" BorderBrush="{Binding BorderColor}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="{Binding Name}" Foreground="{Binding BorderColor}" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Pid, StringFormat=' (PID: {0})'}" Foreground="Gray" FontSize="12" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                    </StackPanel>

                                    <!-- Barra de RAM única y más ancha[cite: 13] -->
                                    <StackPanel Margin="0,10,0,0" MaxWidth="450" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding RamUsage, StringFormat='MEMORIA RAM: {0} GB'}" Foreground="White" FontSize="11" Margin="0,0,0,5"/>
                                        <ProgressBar Value="{Binding RamUsage}" Maximum="16" Height="8" Background="#0a0e1a" Foreground="MediumPurple" BorderThickness="0"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="1" Content="DETENER" 
                                        Click="BtnStop_Click" Background="Transparent" Foreground="{Binding BorderColor}" 
                                        BorderBrush="{Binding BorderColor}" BorderThickness="1" Padding="20,10" FontWeight="Bold" Cursor="Hand" VerticalAlignment="Center">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>