<UserControl x:Class="CoreCare.Views.Components.CategoryBenchmarks"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="20">
        <TextBlock Text="B E N C H M A R K S" Foreground="White" FontSize="26" 
                   FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,5"/>
        <Rectangle Height="2" Width="80" Fill="Cyan" HorizontalAlignment="Center" Margin="0,0,0,30"/>

        <ItemsControl x:Name="CategoriesControl">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,15">
                        <Button Click="Category_Click" Background="#1c2030" BorderThickness="0" Padding="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{Binding CategoryColor}" 
                                            BorderThickness="1,1,1,1" CornerRadius="8" Padding="15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="20" VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1" Margin="15,0">
                                                <TextBlock Text="{Binding Name}" Foreground="{Binding CategoryColor}" FontSize="18" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Description}" Foreground="Gray" FontSize="11"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="▼" Foreground="Gray" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <ItemsControl ItemsSource="{Binding Tests}" Visibility="Collapsed" Margin="5,10,5,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1a1f35" Margin="4" Padding="12" CornerRadius="6" BorderBrush="#22FFFFFF" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="13"/>

                                            <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="Gray" FontSize="10" 
                                                       TextWrapping="Wrap" Margin="0,5"/>

                                            <DockPanel Grid.Row="2" Margin="0,10,0,0">
                                                <TextBlock Text="{Binding EstimatedTime}" Foreground="#444" FontSize="9" VerticalAlignment="Center"/>
                                                <Button Content="EJECUTAR" DockPanel.Dock="Right" Padding="8,3" 
                                                        Background="Cyan" Foreground="Black" FontWeight="Bold" FontSize="9"
                                                        Click="RunTest_Click"/>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>