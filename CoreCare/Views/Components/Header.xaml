<UserControl x:Class="CoreCare.Views.Components.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="64">

    <Border Background="#1C2030" BorderBrush="#3300FFFF" BorderThickness="0,0,0,1">
        <Grid Margin="25,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="C O R E" Foreground="White" FontSize="18" FontWeight="Black"/>
                <TextBlock Text="C A R E" Foreground="Cyan" FontSize="18" FontWeight="Black" Margin="10,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnHome" Content="INICIO" Click="BtnHome_Click" 
                        Background="Transparent" Foreground="White" BorderThickness="0" Margin="10,0" Cursor="Hand"/>

                <Button x:Name="BtnBenchmarks" Content="TESTS" Click="BtnBenchmarks_Click" 
                        Background="Transparent" Foreground="White" BorderThickness="0" Margin="10,0" Cursor="Hand"/>

                <Button x:Name="BtnHistory" Content="HISTORIAL" Click="BtnHistory_Click" 
                        Background="Transparent" Foreground="White" BorderThickness="0" Margin="10,0" Cursor="Hand"/>

                <Button x:Name="BtnLogin" Content="LOGIN" Click="BtnLogin_Click" 
                        Background="#008B8B" Foreground="White" FontWeight="Bold" 
                        Padding="18,6" Margin="10,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>