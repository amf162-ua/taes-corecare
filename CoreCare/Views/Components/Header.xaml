<UserControl x:Class="CoreCare.Views.Components.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="70">

    <Border Background="#151a2e" BorderBrush="#3300FFFF" BorderThickness="0,0,0,1" Padding="20,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="CORE CARE" Foreground="Cyan" FontSize="20" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,30,0"/>

                <Button Content="Inicio" Click="BtnHome_Click" Foreground="White" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="5,0" FontSize="14" FontWeight="SemiBold"/>
                <Button Content="Benchmarks" Click="BtnBenchmarks_Click" Foreground="White" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="5,0" FontSize="14" FontWeight="SemiBold"/>
                <Button Content="Historial" Click="BtnHistory_Click" Foreground="White" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="5,0" FontSize="14" FontWeight="SemiBold"/>
                <Button x:Name="BtnSupport" Content="💬 Soporte" Click="BtnSupport_Click" Foreground="White" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="5,0" FontSize="14" FontWeight="SemiBold" Visibility="Collapsed"/>
                <Button Content="Arranque" Click="BtnArranque_Click" Foreground="#00E5FF" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="5,0" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                <Button x:Name="BtnPremium" Content="⭐ PREMIUM" Click="BtnGoPremium_Click" Visibility="Collapsed"
                        Background="#15FFA500" Foreground="Orange" FontWeight="Bold" FontSize="11" 
                        Padding="12,5" BorderBrush="Orange" Margin="0,0,20,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <StackPanel x:Name="GuestPanel" Orientation="Horizontal" Visibility="Visible">
                    <Button Content="LOGIN" Click="BtnLogin_Click" Background="#1c2030" Foreground="Cyan" FontWeight="Bold" Padding="20,8" BorderBrush="Cyan" BorderThickness="1" Cursor="Hand"/>
                </StackPanel>

                <StackPanel x:Name="UserPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Click="BtnProfile_Click" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="TxtUsername" Text="USUARIO" Foreground="Cyan" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Text="Online" Foreground="#00FF00" FontSize="9" HorizontalAlignment="Right"/>
                            </StackPanel>
                            <Grid>
                                <Ellipse Width="38" Height="38" Fill="#1c2030" Stroke="#3300FFFF" StrokeThickness="1"/>
                                <TextBlock Text="👤" Foreground="Cyan" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                            </Grid>
                        </StackPanel>
                    </Button>
                    <Button Content="Salir" Click="BtnLogout_Click" Foreground="#FF5555" Background="Transparent" BorderThickness="0" Margin="15,0,0,0" FontSize="11" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>