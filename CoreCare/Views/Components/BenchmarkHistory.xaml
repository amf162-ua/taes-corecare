<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="CoreCare.Views.Components.BenchmarkHistory"
             d:DesignHeight="108.567" d:DesignWidth="289.322">

    <StackPanel Margin="15">
        <TextBlock Text="H I S T O R I A L" Foreground="White" FontSize="24" 
                   FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <ItemsControl x:Name="ResultsList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10" Padding="15" CornerRadius="8" 
                            Background="#1c2030" BorderThickness="1" BorderBrush="Cyan">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="RESULTADO DE BENCHMARK" Foreground="Cyan" FontSize="14" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="DURACIÓN: " Foreground="Gray" FontSize="10"/>
                                    <TextBlock Text="{Binding Duration}" Foreground="Gray" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <StackPanel Margin="10,0">
                                    <TextBlock Text="SCORE" Foreground="Gray" FontSize="9" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Score}" Foreground="White" FontWeight="Black" FontSize="16"/>
                                </StackPanel>
                                <StackPanel Margin="10,0">
                                    <TextBlock Text="TEMP PICO" Foreground="Gray" FontSize="9" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding PeakCpuTemp, StringFormat=\{0\}°C}" 
                                               Foreground="White" FontWeight="Black" FontSize="16"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>