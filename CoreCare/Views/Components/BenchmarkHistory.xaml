<UserControl x:Class="CoreCare.Views.Components.BenchmarkHistory"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <StackPanel Margin="15">
        <TextBlock Text="H I S T O R I A L" Foreground="White" FontSize="24" 
                   FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <ItemsControl x:Name="ResultsList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10" Padding="15" CornerRadius="8" 
                            Background="#1c2030" BorderThickness="1" BorderBrush="Cyan">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="REGISTRO DE BENCHMARK" Foreground="Cyan" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Timestamp, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" 
                                           Foreground="Gray" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <StackPanel Margin="10,0">
                                    <TextBlock Text="PUNTOS" Foreground="Gray" FontSize="9" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Score, StringFormat=\{0:F2\}}" Foreground="White" FontWeight="Black" FontSize="16"/>
                                </StackPanel>
                                <StackPanel Margin="10,0">
                                    <TextBlock Text="TEMP" Foreground="Gray" FontSize="9" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CpuTemp, StringFormat=\{0:F0\}°C}" Foreground="White" FontWeight="Black" FontSize="16"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>