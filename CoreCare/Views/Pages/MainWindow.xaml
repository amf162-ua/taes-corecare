<Window x:Class="CoreCare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TuApp"
        Title="Axiom Works - Core Care"
        Height="768" Width="1024"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="{StaticResource BackgroundBrush}" Height="64">
			<TextBlock Text="[Header Placeholder]" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
		</Border>

		<Frame Grid.Row="1"
               x:Name="MainFrame"
               NavigationUIVisibility="Hidden" />

		<Border Grid.Row="2"
                Background="#0A0E1A"
                BorderBrush="#3300BCD4"
                BorderThickness="0,1,0,0"
                Padding="0,32">

			<Grid>
				<Grid.Background>
					<LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
						<GradientStop Color="#0D00BCD4" Offset="0.0" />
						<GradientStop Color="#00000000" Offset="1.0" />
					</LinearGradientBrush>
				</Grid.Background>

				<TextBlock Text="© 2026 AXIOM WORKS. TODOS LOS DERECHOS RESERVADOS."
                           Foreground="{StaticResource MutedForegroundBrush}"
                           FontFamily="{StaticResource FontBody}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                            />
			</Grid>
		</Border>

		<Grid x:Name="ModalOverlay"
              Grid.RowSpan="3"
              Background="#B3000000"
              Visibility="Collapsed">

		</Grid>

		<StackPanel x:Name="ToastContainer"
                    Grid.RowSpan="3"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="20" />
	</Grid>
</Window>