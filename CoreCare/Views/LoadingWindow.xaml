<Window x:Class="CoreCare.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generando informe..."
        Width="430" Height="190"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True">

    <Border Background="#1c2030"
            CornerRadius="14"
            BorderBrush="#3300FFFF"
            BorderThickness="2"
            Padding="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="GENERANDO INFORME"
                       Foreground="Cyan"
                       FontSize="18"
                       FontWeight="Black"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,18"/>
            <ProgressBar x:Name="ProgressBar"
                         IsIndeterminate="False"
                         Width="320"
                         Height="9"
                         Foreground="Cyan"
                         Background="#0a0e1a"
                         BorderThickness="0"/>
            <TextBlock x:Name="StatusText"
                       Text="Iniciando..."
                       Foreground="White"
                       FontSize="14"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0"/>
            <TextBlock x:Name="PercentText"
                       Text="0%"
                       Foreground="Gray"
                       FontSize="12"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>
        </StackPanel>
    </Border>
</Window>
