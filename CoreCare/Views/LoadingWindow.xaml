<Window x:Class="CoreCare.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generando informe..."
        Width="380" Height="170"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True">

    <Border Background="#2D2D2D" CornerRadius="10" Padding="30">
        <StackPanel VerticalAlignment="Center">
            <ProgressBar x:Name="ProgressBar" IsIndeterminate="False" Width="280" Height="6" Foreground="#ff6100"/>
            <TextBlock x:Name="StatusText"
                       Text="Iniciando..."
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0"/>
            <TextBlock x:Name="PercentText"
                       Text="0%"
                       Foreground="#888888"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>
        </StackPanel>
    </Border>
</Window>