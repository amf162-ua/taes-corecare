<Window x:Class="CoreCare.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generando informe..."
        Width="350" Height="150"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True">

    <Border Background="#2D2D2D" CornerRadius="10" Padding="30">
        <StackPanel VerticalAlignment="Center">
            <ProgressBar IsIndeterminate="True" Width="250" Height="6" Foreground="#ff6100"/>
            <TextBlock Text="Generando informe..."
                       Foreground="White"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0"/>
        </StackPanel>
    </Border>
</Window>