<Page x:Class="CoreCare.Views.ArranquePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ArranquePage" Background="#0a0e1a">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Gestor de Arranque" FontSize="32" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Left"/>
            <TextBlock Text="Controla los programas que se inician con Windows" Foreground="#8a9ab8" FontSize="14" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Background="#161b2b">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="#242c42" BorderThickness="0,0,0,1" Padding="15">
                <TextBlock Text="Impacto y Optimización" FontWeight="SemiBold" FontSize="16" Foreground="White"/>
            </Border>

            <DataGrid Grid.Row="1" Margin="15"
                      ItemsSource="{Binding StartupPrograms}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      Background="Transparent"
                      RowHeaderWidth="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#242c42"
                      Foreground="White"
                      BorderThickness="0">

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Margin" Value="0,2"/>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="10" Height="10" Margin="10,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#00E5FF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                    <Setter Property="Fill" Value="#555555"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Programa" Binding="{Binding Name}" Width="150" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Fabricante" Binding="{Binding Publisher}" Width="150" Foreground="#8a9ab8" FontStyle="Italic"/>
                    <DataGridTextColumn Header="Ruta en el Sistema" Binding="{Binding Path}" Width="*" Foreground="#586785"/>

                    <DataGridTemplateColumn Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Abrir ubicación" Background="#242c42" Foreground="White" FontSize="12" Padding="5,2" BorderThickness="0" Cursor="Hand">
                                    <Button.Content>📁</Button.Content>
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Foreground="White" FontSize="11" Padding="5,4" BorderThickness="0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Content" Value="Desactivar"/>
                                            <Setter Property="Background" Value="#FF3D00"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                    <Setter Property="Content" Value="Activar"/>
                                                    <Setter Property="Background" Value="#00C853"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Page>