<Window x:Class="CoreCare.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:oxy="http://oxyplot.org/wpf"
    xmlns:converters="clr-namespace:CoreCare.Converters"
    Title="CoreCare - Monitor de Sistema" Height="600" Width="800">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
    </Window.Resources>

    <Grid Background="#F5F5F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="ClientHeader"
            Grid.Row="0"
            Background="#0E2F33"
            Padding="12,10"
            Margin="10,10,10,0"
            CornerRadius="8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="CoreCare" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{Binding HistoryUserLabel}" Foreground="#D7E7E4" FontSize="12"/>
                </StackPanel>

                <Button DockPanel.Dock="Right"
                        Content="Cerrar sesión"
                        Padding="14,6"
                        Margin="12,0,0,0"
                        Background="#D95C5C"
                        Foreground="White"
                        Click="Logout_Click"/>
            </DockPanel>
        </Border>

        <!-- Admin Panel Host (created only for admin users in code-behind) -->
        <ContentControl x:Name="AdminHost"
                Grid.Row="0"
                Grid.RowSpan="2"
                Visibility="Collapsed"/>

        <!-- Client View (Tabs) -->
        <TabControl x:Name="ClientTabs"
               Grid.Row="1"
               Margin="10">
            <TabItem Header="Benchmark">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Modo:"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              Margin="8,0,0,0"
                              ItemsSource="{Binding BenchmarkOptions}"
                              SelectedItem="{Binding SelectedBenchmarkOption}"
                              DisplayMemberPath="Label"/>

                    <Button Grid.Row="0" Grid.Column="3"
                            Margin="0,0,10,0"
                            Padding="14,5"
                            Command="{Binding RunBenchmarkCommand}"
                            Content="Ejecutar benchmark"/>

                    <TextBlock Grid.Row="0" Grid.Column="4"
                               VerticalAlignment="Center"
                               Foreground="#616161"
                               Text="{Binding BenchmarkDurationSeconds, StringFormat=Duracion: {0} s}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                               Margin="0,10,0,10"
                               FontWeight="SemiBold"
                               Text="{Binding BenchmarkStatus}"/>

                    <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                             Text="{Binding BenchmarkSummary}"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="Monitor" Visibility="{Binding IsAuthenticated, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="20">
                        <TextBlock Text="{Binding CpuDisplay}" FontSize="50" FontWeight="Bold" Foreground="#2196F3" HorizontalAlignment="Center"/>
                        <TextBlock Text="Uso de Procesador" HorizontalAlignment="Center" Foreground="Gray"/>
                        <Button Content="Generar Informe PDF"
                                Command="{Binding GenerateReportCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                Width="170"
                                Height="35"
                                Margin="0,15,0,0"
                                Background="#ff6100"
                                Foreground="White"
                                FontWeight="Bold"
                                HorizontalAlignment="Center">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Processes}"
                              AutoGenerateColumns="False"
                              Margin="10"
                              IsReadOnly="True"
                              Background="White"
                              RowHeaderWidth="0"
                              GridLinesVisibility="None"
                              BorderThickness="0">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHighConsumption}" Value="True">
                                        <Setter Property="Background" Value="#FFEBEB"/>
                                        <Setter Property="Foreground" Value="#C62828"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Aplicación" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="RAM (MB)" Binding="{Binding RamUsageMB, StringFormat=\{0:N0\}}" Width="100"/>
                            <DataGridTextColumn Header="Proceso" Binding="{Binding Name}" Width="150"/>

                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Finalizar"
                                                Command="{Binding DataContext.TerminateProcessCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.IsAdministrador, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Background="#FF5252"
                                                Foreground="White"
                                                FontSize="10"
                                                Padding="5,2"
                                                BorderThickness="0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="3"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Historial">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <!-- Filter controls -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Desde:" FontSize="12"/>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding HistoryFrom}" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="Hasta:" FontSize="12"/>
                            <DatePicker Grid.Column="4" SelectedDate="{Binding HistoryTo}" Margin="8,0,0,0"/>
                            <Button Grid.Column="5" Content="Cargar" Padding="12,6" Margin="8,0,0,0" Command="{Binding LoadHistoryCommand}" Background="#01696f" Foreground="White"/>
                        </Grid>

                        <!-- Header info -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="{Binding HistoryUserLabel}" FontWeight="SemiBold" FontSize="14" Foreground="#333"/>
                            <TextBlock Text="{Binding HistoryStatus}" FontSize="12" Foreground="#666" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- KPI Cards Row -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- KPI: Current Score -->
                            <Border Grid.Column="0" Background="White" BorderBrush="#d4d1ca" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Puntuación Actual" FontSize="10" Foreground="#7a7974" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding KpiCurrentScore}" FontSize="28" FontWeight="Bold" Foreground="#01696f" Margin="0,6,0,0"/>
                                    <TextBlock Text="Estado última ejecución" FontSize="11" Foreground="#7a7974" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- KPI: Degradation -->
                            <Border Grid.Column="1" Background="White" BorderBrush="#d4d1ca" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Degradación" FontSize="10" Foreground="#7a7974" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding KpiDegradation}" FontSize="28" FontWeight="Bold" Foreground="#a13544" Margin="0,6,0,0"/>
                                    <TextBlock Text="Primera vs última ejecución" FontSize="11" Foreground="#7a7974" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- KPI: Worst Component -->
                            <Border Grid.Column="2" Background="White" BorderBrush="#d4d1ca" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Componente Peor" FontSize="10" Foreground="#7a7974" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding KpiWorstComponent}" FontSize="28" FontWeight="Bold" Foreground="#da7101" Margin="0,6,0,0"/>
                                    <TextBlock Text="Mayor varianza" FontSize="11" Foreground="#7a7974" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- KPI: Consistency -->
                            <Border Grid.Column="3" Background="White" BorderBrush="#d4d1ca" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Consistencia" FontSize="10" Foreground="#7a7974" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding KpiConsistency}" FontSize="28" FontWeight="Bold" Foreground="#437a22" Margin="0,6,0,0"/>
                                    <TextBlock Text="Agrupación de ejecuciones" FontSize="11" Foreground="#7a7974" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Small Multiples and Heatmap Section - Side by Side -->
                        <Grid Margin="0,0,0,16" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65*"/>
                                <ColumnDefinition Width="35*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Small Multiples Section -->
                            <Border Grid.Column="0" Background="White" BorderBrush="#d4d1ca" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Tendencias de Métricas" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Gráfico de línea para cada métrica" FontSize="11" Foreground="#7a7974" Margin="0,0,0,12"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="140"/>
                                            <RowDefinition Height="140"/>
                                        </Grid.RowDefinitions>

                                        <!-- CPU Chart -->
                                        <oxy:PlotView x:Name="CpuPlotView" Grid.Row="0" Grid.Column="0" Model="{Binding MiniCpuPlot}" Margin="0,0,8,8">
                                            <oxy:PlotView.DefaultTrackerTemplate>
                                                <ControlTemplate>
                                                    <Border Background="#CC222222" CornerRadius="6" Padding="8">
                                                        <TextBlock Text="{Binding Text}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </oxy:PlotView.DefaultTrackerTemplate>
                                        </oxy:PlotView>
                                        <!-- GPU Chart -->
                                        <oxy:PlotView x:Name="GpuPlotView" Grid.Row="0" Grid.Column="1" Model="{Binding MiniGpuPlot}" Margin="8,0,0,8">
                                            <oxy:PlotView.DefaultTrackerTemplate>
                                                <ControlTemplate>
                                                    <Border Background="#CC222222" CornerRadius="6" Padding="8">
                                                        <TextBlock Text="{Binding Text}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </oxy:PlotView.DefaultTrackerTemplate>
                                        </oxy:PlotView>
                                        <!-- RAM Chart -->
                                        <oxy:PlotView x:Name="RamPlotView" Grid.Row="1" Grid.Column="0" Model="{Binding MiniRamPlot}" Margin="0,8,8,0">
                                            <oxy:PlotView.DefaultTrackerTemplate>
                                                <ControlTemplate>
                                                    <Border Background="#CC222222" CornerRadius="6" Padding="8">
                                                        <TextBlock Text="{Binding Text}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </oxy:PlotView.DefaultTrackerTemplate>
                                        </oxy:PlotView>
                                        <!-- Disk Chart -->
                                        <oxy:PlotView x:Name="DiskPlotView" Grid.Row="1" Grid.Column="1" Model="{Binding MiniDiskPlot}" Margin="8,8,0,0">
                                            <oxy:PlotView.DefaultTrackerTemplate>
                                                <ControlTemplate>
                                                    <Border Background="#CC222222" CornerRadius="6" Padding="8">
                                                        <TextBlock Text="{Binding Text}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </oxy:PlotView.DefaultTrackerTemplate>
                                        </oxy:PlotView>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Heatmap Section -->
                            <Border Grid.Column="1" Background="White" BorderBrush="#d4d1ca" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Mapa de Calor de Ejecuciones" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Métricas por ejecución: rojo más oscuro = carga mayor" FontSize="11" Foreground="#7a7974" Margin="0,0,0,12"/>
                                    <Canvas x:Name="HeatmapCanvas" Height="300" Background="#FAFAFA" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Vertical" Margin="0,0,0,0">
                                        <TextBlock Text="Leyenda" FontSize="10" FontWeight="SemiBold" Foreground="#7a7974" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Rectangle Width="14" Height="14" Fill="#FFE8E8" Stroke="#ddd" StrokeThickness="0.5" Margin="0,0,6,0"/>
                                            <TextBlock Text="Bajo" FontSize="10" Foreground="#7a7974"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Rectangle Width="14" Height="14" Fill="#FFCCCC" Stroke="#ddd" StrokeThickness="0.5" Margin="0,0,6,0"/>
                                            <TextBlock Text="Medio" FontSize="10" Foreground="#7a7974"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Rectangle Width="14" Height="14" Fill="#FF9999" Stroke="#ddd" StrokeThickness="0.5" Margin="0,0,6,0"/>
                                            <TextBlock Text="Alto" FontSize="10" Foreground="#7a7974"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="14" Height="14" Fill="#CC0000" Stroke="#999" StrokeThickness="0.5" Margin="0,0,6,0"/>
                                            <TextBlock Text="Muy Alto" FontSize="10" Foreground="#7a7974"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Data Table -->
                        <Border Background="White" BorderBrush="#d4d1ca" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Ejecuciones Detalladas" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <DataGrid ItemsSource="{Binding HistoryItems}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          Background="White"
                                          RowHeaderWidth="0"
                                          GridLinesVisibility="Horizontal"
                                          BorderThickness="0"
                                          MaxHeight="400"
                                          CanUserSortColumns="True">
                                    <DataGrid.Resources>
                                        <Style TargetType="{x:Type DataGridColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Foreground" Value="#111"/>
                                            <Setter Property="Padding" Value="10,6"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                                                        <Border Background="#F7F7F7" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                                            <Grid>
                                                                <ContentPresenter Margin="0,0,16,0"
                                                                                  VerticalAlignment="Center"
                                                                                  HorizontalAlignment="Left"/>
                                                                <TextBlock x:Name="SortArrow"
                                                                           Text="▲"
                                                                           FontSize="9"
                                                                           Foreground="Black"
                                                                           HorizontalAlignment="Right"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,6,0"
                                                                           Visibility="Collapsed"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="SortDirection" Value="Ascending">
                                                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                                                <Setter TargetName="SortArrow" Property="Text" Value="▲"/>
                                                            </Trigger>
                                                            <Trigger Property="SortDirection" Value="Descending">
                                                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                                                <Setter TargetName="SortArrow" Property="Text" Value="▼"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ejecución" Binding="{Binding RunLabel}" Width="70" MinWidth="55" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Fecha" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" SortMemberPath="Timestamp" Width="2*" MinWidth="170"/>
                                        <DataGridTextColumn Header="Puntuación" Binding="{Binding Score, StringFormat=\{0:F1\}}" Width="*" MinWidth="180"/>
                                        <DataGridTextColumn Header="CPU %" Binding="{Binding CpuLoad, StringFormat=\{0:F1\}}" Width="*" MinWidth="180"/>
                                        <DataGridTextColumn Header="GPU %" Binding="{Binding GpuLoad, StringFormat=\{0:F1\}}" Width="*" MinWidth="180"/>
                                        <DataGridTextColumn Header="RAM %" Binding="{Binding RamLoad, StringFormat=\{0:F1\}}" Width="*" MinWidth="180"/>
                                        <DataGridTextColumn Header="Disco %" Binding="{Binding DiskLoad, StringFormat=\{0:F1\}}" Width="*" MinWidth="180"/>
                                        <DataGridTemplateColumn Header="Detalle" Width="*" MinWidth="150">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Ver" Padding="8,2" Width="100" Command="{Binding DataContext.ShowHistoryDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Floating hover popup (starts closed) -->
                        <Popup x:Name="HoverPopup" IsOpen="False" AllowsTransparency="True" Placement="Mouse" StaysOpen="False">
                            <Border Background="#CC222222" CornerRadius="6" Padding="8" BorderBrush="#444" BorderThickness="1">
                                <TextBlock x:Name="HoverPopupText" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                            </Border>
                        </Popup>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
