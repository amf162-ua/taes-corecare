<Window x:Class="CoreCare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:CoreCare.Views.Components"
        Title="Core Care by AXIOM WORKS" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen" Background="#0a0e1a">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <components:Header Grid.Row="0" x:Name="GlobalHeader" />

        <Frame Grid.Row="1" x:Name="MainContentArea" NavigationUIVisibility="Hidden" />

    </Grid>
</Window>