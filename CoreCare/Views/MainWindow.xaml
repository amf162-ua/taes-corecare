<Window x:Class="CoreCare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoreCare - Monitor de Sistema" Height="650" Width="1100">

    <Grid Background="#F5F5F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20">
            <TextBlock Text="{Binding CpuDisplay}" FontSize="50" FontWeight="Bold" Foreground="#2196F3" HorizontalAlignment="Center"/>
            <TextBlock Text="Uso de Procesador" HorizontalAlignment="Center" Foreground="Gray"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Procesos Activos" FontWeight="Bold" FontSize="16" Foreground="#333" Margin="0,0,0,10"/>

                <DataGrid Grid.Row="1" 
                          ItemsSource="{Binding Processes}" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          Background="White"
                          RowHeaderWidth="0"
                          GridLinesVisibility="None"
                          BorderThickness="0">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHighConsumption}" Value="True">
                                    <Setter Property="Background" Value="#FFEBEB"/>
                                    <Setter Property="Foreground" Value="#C62828"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Aplicación" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="RAM (MB)" Binding="{Binding RamUsageMB, StringFormat=\{0:N0\}}" Width="80"/>
                        <DataGridTextColumn Header="Proceso" Binding="{Binding Name}" Width="130"/>

                        <DataGridTemplateColumn Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.TerminateProcessCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Foreground="White" 
                                            FontSize="10" 
                                            Padding="5,2"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <!-- Diseño por defecto (Procesos normales) -->
                                                <Setter Property="Content" Value="Finalizar"/>
                                                <Setter Property="Background" Value="#FF5252"/>
                                                <Setter Property="IsEnabled" Value="True"/>

                                                <Style.Triggers>
                                                    <!-- NUEVO: Si es crítico, lo blindamos -->
                                                    <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <!-- Desactiva el clic -->
                                                        <Setter Property="Background" Value="#FFCDD2"/>
                                                        <!-- Rojo deslavado -->
                                                        <Setter Property="Content" Value="Protegido"/>
                                                        <!-- Cambia el texto -->
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="3"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Impacto en el Arranque" FontWeight="Bold" FontSize="16" Foreground="#333" Margin="0,0,0,10"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding StartupPrograms}" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          Background="White"
                          RowHeaderWidth="0"
                          GridLinesVisibility="None"
                          BorderThickness="0">

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="30">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="10" Height="10" Margin="5,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#4CAF50"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Fill" Value="#9E9E9E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Programa" Binding="{Binding Name}" Width="120" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Fabricante" Binding="{Binding Publisher}" Width="145" Foreground="#555" FontStyle="Italic"/>
                        <DataGridTextColumn Header="Ruta" Binding="{Binding Path}" Width="*" Foreground="Gray"/>

                        <DataGridTemplateColumn Width="35">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Abrir ubicación del archivo"
                                            Background="#E0E0E0" 
                                            Foreground="#333" 
                                            FontSize="12" 
                                            Padding="5,2"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Content>📁</Button.Content>
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="3"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="75">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Foreground="White" 
                                            FontSize="10" 
                                            Padding="5,2"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="Desactivar"/>
                                                <Setter Property="Background" Value="#FFB300"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Content" Value="Activar"/>
                                                        <Setter Property="Background" Value="#4CAF50"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="3"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</Window>