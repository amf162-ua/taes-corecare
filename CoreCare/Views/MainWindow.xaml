<Window x:Class="CoreCare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoreCare - Monitor de Sistema" Height="600" Width="800">

    <Grid Background="#F5F5F7">
        <TabControl Margin="10">
            <TabItem Header="Benchmark">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Modo:"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              Margin="8,0,0,0"
                              ItemsSource="{Binding BenchmarkOptions}"
                              SelectedItem="{Binding SelectedBenchmarkOption}"
                              DisplayMemberPath="Label"/>

                    <Button Grid.Row="0" Grid.Column="3"
                            Margin="0,0,10,0"
                            Padding="14,5"
                            Command="{Binding RunBenchmarkCommand}"
                            Content="Ejecutar benchmark"/>

                    <TextBlock Grid.Row="0" Grid.Column="4"
                               VerticalAlignment="Center"
                               Foreground="#616161"
                               Text="{Binding BenchmarkDurationSeconds, StringFormat=Duracion: {0} s}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                               Margin="0,10,0,10"
                               FontWeight="SemiBold"
                               Text="{Binding BenchmarkStatus}"/>

                    <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                             Text="{Binding BenchmarkSummary}"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="Monitor">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="20">
                        <TextBlock Text="{Binding CpuDisplay}" FontSize="50" FontWeight="Bold" Foreground="#2196F3" HorizontalAlignment="Center"/>
                        <TextBlock Text="Uso de Procesador" HorizontalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Processes}"
                              AutoGenerateColumns="False"
                              Margin="10"
                              IsReadOnly="True"
                              Background="White"
                              RowHeaderWidth="0"
                              GridLinesVisibility="None"
                              BorderThickness="0">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHighConsumption}" Value="True">
                                        <Setter Property="Background" Value="#FFEBEB"/>
                                        <Setter Property="Foreground" Value="#C62828"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Aplicación" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="RAM (MB)" Binding="{Binding RamUsageMB, StringFormat=\{0:N0\}}" Width="100"/>
                            <DataGridTextColumn Header="Proceso" Binding="{Binding Name}" Width="150"/>

                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Finalizar"
                                                Command="{Binding DataContext.TerminateProcessCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="#FF5252"
                                                Foreground="White"
                                                FontSize="10"
                                                Padding="5,2"
                                                BorderThickness="0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="3"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Historial">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Desde:"/>
                    <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding HistoryFrom}"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Text="Hasta:"/>
                    <DatePicker Grid.Row="0" Grid.Column="4" SelectedDate="{Binding HistoryTo}"/>
                    <Button Grid.Row="0" Grid.Column="6"
                            Content="Cargar"
                            Padding="10,4"
                            Command="{Binding LoadHistoryCommand}"/>

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="8" Margin="0,10,0,10">
                        <TextBlock Text="{Binding HistoryStatus}" Foreground="#444"/>
                        <TextBlock Text="{Binding TrendStatus}" Foreground="#0D47A1" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding DegradationStatus}" FontWeight="SemiBold" Foreground="{Binding DegradationBrush}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="8"
                              ItemsSource="{Binding HistoryItems}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="White"
                              RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="170"/>
                            <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat=\{0:F1\}}" Width="80"/>
                            <DataGridTextColumn Header="CPU %" Binding="{Binding CpuLoad, StringFormat=\{0:F1\}}" Width="80"/>
                            <DataGridTextColumn Header="GPU %" Binding="{Binding GpuLoad, StringFormat=\{0:F1\}}" Width="80"/>
                            <DataGridTextColumn Header="RAM %" Binding="{Binding RamLoad, StringFormat=\{0:F1\}}" Width="80"/>
                            <DataGridTextColumn Header="Disco %" Binding="{Binding DiskLoad, StringFormat=\{0:F1\}}" Width="80"/>
                            <DataGridTextColumn Header="Usuario" Binding="{Binding UserId}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>