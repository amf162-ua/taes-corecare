<Window x:Class="CoreCare.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:oxy="http://oxyplot.org/wpf"
    Title="CoreCare - Monitor de Sistema" Height="600" Width="800">

    <Grid Background="#F5F5F7">
        <TabControl Margin="10">
            <TabItem Header="Benchmark">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Modo:"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              Margin="8,0,0,0"
                              ItemsSource="{Binding BenchmarkOptions}"
                              SelectedItem="{Binding SelectedBenchmarkOption}"
                              DisplayMemberPath="Label"/>

                    <Button Grid.Row="0" Grid.Column="3"
                            Margin="0,0,10,0"
                            Padding="14,5"
                            Command="{Binding RunBenchmarkCommand}"
                            Content="Ejecutar benchmark"/>

                    <TextBlock Grid.Row="0" Grid.Column="4"
                               VerticalAlignment="Center"
                               Foreground="#616161"
                               Text="{Binding BenchmarkDurationSeconds, StringFormat=Duracion: {0} s}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                               Margin="0,10,0,10"
                               FontWeight="SemiBold"
                               Text="{Binding BenchmarkStatus}"/>

                    <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                             Text="{Binding BenchmarkSummary}"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="Monitor">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="20">
                        <TextBlock Text="{Binding CpuDisplay}" FontSize="50" FontWeight="Bold" Foreground="#2196F3" HorizontalAlignment="Center"/>
                        <TextBlock Text="Uso de Procesador" HorizontalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Processes}"
                              AutoGenerateColumns="False"
                              Margin="10"
                              IsReadOnly="True"
                              Background="White"
                              RowHeaderWidth="0"
                              GridLinesVisibility="None"
                              BorderThickness="0">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHighConsumption}" Value="True">
                                        <Setter Property="Background" Value="#FFEBEB"/>
                                        <Setter Property="Foreground" Value="#C62828"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Aplicación" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="RAM (MB)" Binding="{Binding RamUsageMB, StringFormat=\{0:N0\}}" Width="100"/>
                            <DataGridTextColumn Header="Proceso" Binding="{Binding Name}" Width="150"/>

                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Finalizar"
                                                Command="{Binding DataContext.TerminateProcessCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="#FF5252"
                                                Foreground="White"
                                                FontSize="10"
                                                Padding="5,2"
                                                BorderThickness="0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="3"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Historial">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <!-- Filter controls -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Desde:" FontSize="12"/>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding HistoryFrom}" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="Hasta:" FontSize="12"/>
                            <DatePicker Grid.Column="4" SelectedDate="{Binding HistoryTo}" Margin="8,0,0,0"/>
                            <Button Grid.Column="5" Content="Cargar" Padding="12,6" Margin="8,0,0,0" Command="{Binding LoadHistoryCommand}" Background="#01696f" Foreground="White"/>
                        </Grid>

                        <!-- Header info -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="{Binding HistoryUserLabel}" FontWeight="SemiBold" FontSize="14" Foreground="#333"/>
                            <TextBlock Text="{Binding HistoryStatus}" FontSize="12" Foreground="#666" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- KPI Cards Row -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- KPI: Current Score -->
                            <Border Grid.Column="0" Background="White" BorderBrush="#d4d1ca" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Current Score" FontSize="10" Foreground="#7a7974" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding KpiCurrentScore}" FontSize="28" FontWeight="Bold" Foreground="#01696f" Margin="0,6,0,0"/>
                                    <TextBlock Text="Last run status" FontSize="11" Foreground="#7a7974" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- KPI: Degradation -->
                            <Border Grid.Column="1" Background="White" BorderBrush="#d4d1ca" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Degradation" FontSize="10" Foreground="#7a7974" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding KpiDegradation}" FontSize="28" FontWeight="Bold" Foreground="#a13544" Margin="0,6,0,0"/>
                                    <TextBlock Text="First vs last run" FontSize="11" Foreground="#7a7974" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- KPI: Worst Component -->
                            <Border Grid.Column="2" Background="White" BorderBrush="#d4d1ca" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Worst Component" FontSize="10" Foreground="#7a7974" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding KpiWorstComponent}" FontSize="28" FontWeight="Bold" Foreground="#da7101" Margin="0,6,0,0"/>
                                    <TextBlock Text="Largest variance" FontSize="11" Foreground="#7a7974" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- KPI: Consistency -->
                            <Border Grid.Column="3" Background="White" BorderBrush="#d4d1ca" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Consistency" FontSize="10" Foreground="#7a7974" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding KpiConsistency}" FontSize="28" FontWeight="Bold" Foreground="#437a22" Margin="0,6,0,0"/>
                                    <TextBlock Text="Run clustering" FontSize="11" Foreground="#7a7974" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Small Multiples and Heatmap Section - Side by Side -->
                        <Grid Margin="0,0,0,16" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65*"/>
                                <ColumnDefinition Width="35*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Small Multiples Section -->
                            <Border Grid.Column="0" Background="White" BorderBrush="#d4d1ca" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Metric Trends" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Line chart for each metric" FontSize="11" Foreground="#7a7974" Margin="0,0,0,12"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="140"/>
                                            <RowDefinition Height="140"/>
                                        </Grid.RowDefinitions>

                                        <!-- CPU Chart -->
                                        <oxy:PlotView Grid.Row="0" Grid.Column="0" Model="{Binding MiniCpuPlot}" Margin="0,0,8,8"/>
                                        <!-- GPU Chart -->
                                        <oxy:PlotView Grid.Row="0" Grid.Column="1" Model="{Binding MiniGpuPlot}" Margin="8,0,0,8"/>
                                        <!-- RAM Chart -->
                                        <oxy:PlotView Grid.Row="1" Grid.Column="0" Model="{Binding MiniRamPlot}" Margin="0,8,8,0"/>
                                        <!-- Disk Chart -->
                                        <oxy:PlotView Grid.Row="1" Grid.Column="1" Model="{Binding MiniDiskPlot}" Margin="8,8,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Heatmap Section -->
                            <Border Grid.Column="1" Background="White" BorderBrush="#d4d1ca" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Run Heatmap" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Metrics by run: darker red = higher load" FontSize="11" Foreground="#7a7974" Margin="0,0,0,12"/>
                                    <Canvas x:Name="HeatmapCanvas" Height="300" Background="#FAFAFA" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Vertical" Margin="0,0,0,0">
                                        <TextBlock Text="Legend" FontSize="10" FontWeight="SemiBold" Foreground="#7a7974" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Rectangle Width="14" Height="14" Fill="#FFE8E8" Stroke="#ddd" StrokeThickness="0.5" Margin="0,0,6,0"/>
                                            <TextBlock Text="Low" FontSize="10" Foreground="#7a7974"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Rectangle Width="14" Height="14" Fill="#FFCCCC" Stroke="#ddd" StrokeThickness="0.5" Margin="0,0,6,0"/>
                                            <TextBlock Text="Medium" FontSize="10" Foreground="#7a7974"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Rectangle Width="14" Height="14" Fill="#FF9999" Stroke="#ddd" StrokeThickness="0.5" Margin="0,0,6,0"/>
                                            <TextBlock Text="High" FontSize="10" Foreground="#7a7974"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="14" Height="14" Fill="#CC0000" Stroke="#999" StrokeThickness="0.5" Margin="0,0,6,0"/>
                                            <TextBlock Text="Very High" FontSize="10" Foreground="#7a7974"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Data Table -->
                        <Border Background="White" BorderBrush="#d4d1ca" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Detailed Runs" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <DataGrid ItemsSource="{Binding HistoryItems}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          Background="White"
                                          RowHeaderWidth="0"
                                          GridLinesVisibility="Horizontal"
                                          BorderThickness="0"
                                          MaxHeight="400">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Fecha" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="2*" MinWidth="170"/>
                                        <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat=\{0:F1\}}" Width="*" MinWidth="200"/>
                                        <DataGridTextColumn Header="CPU %" Binding="{Binding CpuLoad, StringFormat=\{0:F1\}}" Width="*" MinWidth="200"/>
                                        <DataGridTextColumn Header="GPU %" Binding="{Binding GpuLoad, StringFormat=\{0:F1\}}" Width="*" MinWidth="200"/>
                                        <DataGridTextColumn Header="RAM %" Binding="{Binding RamLoad, StringFormat=\{0:F1\}}" Width="*" MinWidth="200"/>
                                        <DataGridTextColumn Header="Disco %" Binding="{Binding DiskLoad, StringFormat=\{0:F1\}}" Width="*" MinWidth="200"/>
                                        <DataGridTemplateColumn Header="Detalle" Width="200">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Ver" Padding="8,2" Command="{Binding DataContext.ShowHistoryDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Floating hover popup (starts closed) -->
                        <Popup x:Name="HoverPopup" IsOpen="False" AllowsTransparency="True" Placement="Mouse" StaysOpen="False">
                            <Border Background="#CC222222" CornerRadius="6" Padding="8" BorderBrush="#444" BorderThickness="1">
                                <TextBlock x:Name="HoverPopupText" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                            </Border>
                        </Popup>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>