<Window x:Class="CoreCare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Core Care by AXIOM WORKS" Height="720" Width="1280"
        Background="#0a0e1a">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
			<Button Content="Login" Command="{Binding LoginCommand}" Margin="5"/>
			<Button Content="Premium" Command="{Binding PremiumCommand}" Margin="5"/>
			<Button Content="Perfil" Command="{Binding ProfileCommand}" Margin="5"/>
		</StackPanel>

		<Frame Grid.Row="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"/>

		<Border Grid.Row="2" BorderBrush="#3300FFFF" BorderThickness="0,1,0,0" Padding="20">
			<TextBlock Text="© 2026 AXIOM WORKS. TODOS LOS DERECHOS RESERVADOS."
                       Foreground="Gray" HorizontalAlignment="Center"/>
		</Border>
	</Grid>
</Window>