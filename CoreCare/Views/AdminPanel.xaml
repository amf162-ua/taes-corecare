<UserControl x:Class="CoreCare.Views.AdminPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:CoreCare.Converters"
    xmlns:converters="clr-namespace:CoreCare.Converters"
    xmlns:models="clr-namespace:CoreCare.Models"
    Background="#F5F5F7">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
        <local:CountToStringConverter x:Key="CountToStringConverter"/>
        <local:DateTimeToFormattedStringConverter x:Key="DateTimeConverter"/>
        
        <!-- Converters for role and plan badges -->
        <local:RoleToBrushConverter x:Key="RoleToBrushConverter"/>
        <local:PlanToBrushConverter x:Key="PlanToBrushConverter"/>
        <local:StringToRoleConverter x:Key="StringToRoleConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Admin Header -->
        <Border Grid.Row="0" Background="#0E2F33" Padding="12,10" Margin="10,10,10,0" CornerRadius="8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="CoreCare - Panel de Administración" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{Binding AdminUserLabel}" Foreground="#D7E7E4" FontSize="12"/>
                </StackPanel>

                <Button DockPanel.Dock="Right"
                        Content="Cerrar sesión"
                        Padding="14,6"
                        Margin="12,0,0,0"
                        Background="#D95C5C"
                        Foreground="White"
                        Click="Logout_Click"/>
            </DockPanel>
        </Border>

        <!-- Main Content Area with Tabs -->
        <TabControl Grid.Row="1" Margin="10" Background="#FBFCFD" BorderBrush="#D4D1CA" BorderThickness="1">
            <!-- Chats Tab -->
            <TabItem Header="Chats" Background="#F4F6F8" Foreground="#0E2F33">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Open Chats List -->
                    <Grid Grid.Column="0" Margin="10,10,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="Chats Abiertos" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="#0E2F33"
                           Margin="0,0,0,10"/>

                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="{Binding PendingChatsCount, Converter={StaticResource CountToStringConverter}}" 
                               FontSize="12" 
                               Foreground="#D95C5C" 
                               FontWeight="SemiBold"/>
                </StackPanel>

                <Border Grid.Row="2" Background="White" BorderBrush="#D4D1CA" BorderThickness="1" CornerRadius="4">
                    <ListBox ItemsSource="{Binding OpenChats}"
                             SelectedItem="{Binding SelectedChat}"
                             Background="White"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ClientName}" 
                                                   FontWeight="Bold" 
                                                   Foreground="#0E2F33"/>
                                        <TextBlock Text="{Binding Subject}" 
                                                   FontSize="11" 
                                                   Foreground="#666" 
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding CreatedAt, Converter={StaticResource DateTimeConverter}}" 
                                                   FontSize="10" 
                                                   Foreground="#999" 
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Pending Badge -->
                                    <Border Grid.Column="1" 
                                            Background="#D95C5C" 
                                            CornerRadius="10" 
                                            Padding="6,2"
                                            VerticalAlignment="Top"
                                            Margin="8,0,0,0"
                                            Visibility="{Binding HasUnreadMessages, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Nuevo" 
                                                   Foreground="White" 
                                                   FontSize="10" 
                                                   FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- Chat Detail Area -->
            <Border Grid.Column="1" Background="White" BorderBrush="#D4D1CA" BorderThickness="1" CornerRadius="4" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                <!-- No Chat Selected -->
                  <StackPanel Grid.Row="0" Grid.RowSpan="3" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center"
                          Visibility="{Binding IsDetailPaneOpen, Converter={StaticResource InverseBool}}">
                    <TextBlock Text="Selecciona un chat para ver los detalles" 
                               FontSize="16" 
                               Foreground="#999" 
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Chat Header -->
                <Border Grid.Row="0" 
                       Padding="0,0,0,15" 
                       BorderBrush="#E0E0E0" 
                       BorderThickness="0,0,0,1"
                       Visibility="{Binding IsDetailPaneOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="{Binding SelectedChat.ClientName}" 
                                       FontSize="14" 
                                       FontWeight="Bold" 
                                       Foreground="#0E2F33"/>
                            <TextBlock Text="{Binding SelectedChat.Subject}" 
                                       FontSize="12" 
                                       Foreground="#666" 
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button DockPanel.Dock="Right"
                               Content="Cerrar Chat"
                               Padding="12,6"
                               Background="#D95C5C"
                               Foreground="White"
                               Command="{Binding CloseSelectedChatCommand}"/>
                    </DockPanel>
                </Border>

                <!-- Chat Messages -->
                <ListBox Grid.Row="1"
                        ItemsSource="{Binding SelectedChatMessages}"
                        Background="White"
                        BorderThickness="0"
                        Margin="0,15,0,15"
                        Visibility="{Binding IsDetailPaneOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Margin="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding SenderName}" 
                                                  FontWeight="Bold" 
                                                  Foreground="#0E2F33"
                                                  FontSize="11"/>
                                        <TextBlock Text="{Binding Message}" 
                                                  Foreground="#333" 
                                                  TextWrapping="Wrap"
                                                  Margin="0,4,0,4"/>
                                        <TextBlock Text="{Binding SentAt, Converter={StaticResource DateTimeConverter}}" 
                                                  FontSize="10" 
                                                  Foreground="#999"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Message Input -->
                <Grid Grid.Row="2" 
                     Visibility="{Binding IsDetailPaneOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" 
                           Background="White"
                           BorderBrush="#D4D1CA"
                           BorderThickness="1"
                           CornerRadius="4"
                           Margin="0,0,10,0">
                        <TextBox Text="{Binding NewMessageText, UpdateSourceTrigger=PropertyChanged}"
                                Padding="10,8"
                                Background="Transparent"
                                BorderThickness="0"
                                TextWrapping="Wrap"
                                AcceptsReturn="False"
                                MaxHeight="60"
                                VerticalScrollBarVisibility="Auto"/>
                    </Border>

                    <Button Grid.Column="1"
                           Content="Enviar"
                           Padding="14,8"
                           Background="#01696F"
                           Foreground="White"
                           Command="{Binding SendMessageCommand}"/>
                </Grid>
                </Grid>
            </Border>
                </Grid>
            </TabItem>

            <!-- Users Tab -->
            <TabItem Header="Usuarios" Background="#F4F6F8" Foreground="#0E2F33">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filters -->
                    <Border Grid.Row="0" Background="White" BorderBrush="#D4D1CA" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Search by username/email -->
                            <Border Grid.Column="0"
                                    Background="White"
                                    BorderBrush="#D4D1CA"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <TextBox x:Name="SearchBox"
                                         Text="{Binding UserSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#030213"/>
                            </Border>

                            <!-- Role Filter -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Rol:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#0E2F33" FontWeight="SemiBold"/>
                                <ComboBox x:Name="RoleFilterCombo"
                                          Width="140" 
                                          Background="White"
                                          BorderBrush="#D4D1CA"
                                          BorderThickness="1"
                                          Foreground="#030213"
                                          SelectionChanged="RoleFilter_SelectionChanged">
                                    <ComboBoxItem>Todos</ComboBoxItem>
                                    <ComboBoxItem>Cliente</ComboBoxItem>
                                    <ComboBoxItem>Administrador</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>

                            <!-- Clear Filters -->
                            <Button Grid.Column="2"
                                    Content="Limpiar filtros"
                                    Margin="12,0,0,0"
                                    Padding="12,6"
                                    Background="#E8EFEF"
                                    Foreground="#0E2F33"
                                    Command="{Binding ClearUserFiltersCommand}"/>

                            <!-- Refresh -->
                            <Button Grid.Column="3"
                                    Content="Actualizar"
                                    Margin="8,0,0,0"
                                    Padding="12,6"
                                    Background="#01696F"
                                    Foreground="White"
                                    Click="RefreshUsers_Click"/>
                        </Grid>
                    </Border>

                    <!-- Users Count -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding FilteredUsers.Count, StringFormat=Total de usuarios: {0}}"
                               FontSize="12"
                               Foreground="#666"
                               Margin="0,0,0,10"
                               FontWeight="SemiBold"/>

                    <!-- Users Grid -->
                    <Border Grid.Row="2" Background="White" BorderBrush="#D4D1CA" BorderThickness="1" CornerRadius="4" Padding="0">
                        <ListBox ItemsSource="{Binding FilteredUsers}"
                                 SelectedItem="{Binding SelectedUser}"
                                 Background="White"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12" Margin="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- User Info -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Username}" 
                                                           FontWeight="Bold" 
                                                           Foreground="#0E2F33"
                                                           FontSize="12"/>
                                                <TextBlock Text="{Binding Name}" 
                                                           FontSize="11" 
                                                           Foreground="#666" 
                                                           Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Email}" 
                                                           FontSize="10" 
                                                           Foreground="#999" 
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Role Badge -->
                                            <Border Grid.Column="1"
                                                    Background="{Binding Role, Converter={StaticResource RoleToBrushConverter}}"
                                                    CornerRadius="12"
                                                    Padding="10,4"
                                                    Margin="8,0">
                                                <TextBlock Text="{Binding Role}" 
                                                           Foreground="White" 
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           TextAlignment="Center"/>
                                            </Border>

                                            <!-- Plan Badge -->
                                            <Border Grid.Column="2"
                                                    Background="{Binding Plan, Converter={StaticResource PlanToBrushConverter}}"
                                                    CornerRadius="12"
                                                    Padding="10,4"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Plan}" 
                                                           Foreground="White" 
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           TextAlignment="Center"/>
                                            </Border>

                                            <!-- Toggle Role Button -->
                                            <Button Grid.Column="3"
                                                    Content="Cambiar Rol"
                                                    Padding="10,4"
                                                    Margin="4,0"
                                                    Background="#F4A460"
                                                    Foreground="White"
                                                    FontSize="10"
                                                    Command="{Binding DataContext.ToggleUserRoleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"/>

                                            <!-- Toggle Plan Button -->
                                            <Button Grid.Column="4"
                                                    Content="Cambiar Plan"
                                                    Padding="10,4"
                                                    Margin="4,0,8,0"
                                                    Background="#20B2AA"
                                                    Foreground="White"
                                                    FontSize="10"
                                                    Command="{Binding DataContext.ToggleUserPlanCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"/>

                                            <!-- Delete Button -->
                                            <Button Grid.Column="5"
                                                    Content="Eliminar"
                                                    Padding="10,4"
                                                    Background="#D95C5C"
                                                    Foreground="White"
                                                    FontSize="10"
                                                    Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
