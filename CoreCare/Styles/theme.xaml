<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<FontFamily x:Key="FontHeading">/Fonts/#Orbitron</FontFamily>
	<FontFamily x:Key="FontBody">/Fonts/#Rajdhani</FontFamily>

	<SolidColorBrush x:Key="BackgroundBrush" Color="#0A0E1A" />
	<SolidColorBrush x:Key="ForegroundBrush" Color="#E4E8F0" />
	<SolidColorBrush x:Key="CardBrush" Color="#1C2030" />
	<SolidColorBrush x:Key="CardForegroundBrush" Color="#E4E8F0" />
	<SolidColorBrush x:Key="PopoverBrush" Color="#1C2030" />

	<SolidColorBrush x:Key="PrimaryBrush" Color="#030213" />
	<SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#FFFFFF" />
	<SolidColorBrush x:Key="SecondaryBrush" Color="#F1F5F9" />
	<SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#030213" />

	<SolidColorBrush x:Key="MutedBrush" Color="#ECECF0" />
	<SolidColorBrush x:Key="MutedForegroundBrush" Color="#717182" />

	<SolidColorBrush x:Key="AccentBrush" Color="#E9EBEF" />
	<SolidColorBrush x:Key="AccentForegroundBrush" Color="#030213" />

	<SolidColorBrush x:Key="DestructiveBrush" Color="#D4183D" />
	<SolidColorBrush x:Key="DestructiveForegroundBrush" Color="#FFFFFF" />

	<SolidColorBrush x:Key="InputBorderBrush" Color="#1A000000" />
	<SolidColorBrush x:Key="InputBackgroundBrush" Color="#F3F3F5" />

	<Style TargetType="TextBlock">
		<Setter Property="FontFamily" Value="{StaticResource FontBody}" />
		<Setter Property="FontSize" Value="16" />
	</Style>

	<Style x:Key="HeaderTextBlockStyle" TargetType="TextBlock">
		<Setter Property="FontFamily" Value="{StaticResource FontHeading}" />
		<Setter Property="Foreground" Value="#030213" />
		<Setter Property="FontWeight" Value="Medium" />
	</Style>

	<Style TargetType="Button">
		<Setter Property="FontFamily" Value="{StaticResource FontHeading}" />
		<Setter Property="Background" Value="{StaticResource SecondaryBrush}" />
		<Setter Property="Foreground" Value="{StaticResource SecondaryForegroundBrush}" />
		<Setter Property="FontSize" Value="16" />
		<Setter Property="Padding" Value="16,8" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Background="{TemplateBinding Background}"
						CornerRadius="10"
						BorderBrush="{StaticResource InputBorderBrush}"
						BorderThickness="1">
						<ContentPresenter HorizontalAlignment="Center"
									  VerticalAlignment="Center"
									  TextElement.Foreground="{TemplateBinding Foreground}"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Background" Value="{StaticResource MutedBrush}" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter Property="Background" Value="{StaticResource AccentBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>